---
const { actions, defaultAction } = Astro.props;
// console.log(actions);
---

<div class="toggle" {...Astro.props}>
  <div class="toggleFloater"></div>
  {
    actions.map(({ id, label }) => {
      return (
        <button
          class:list={["toggleButton", { active: id == defaultAction }]}
          id={id}
        >
          {label}
        </button>
      );
    })
  }
</div>

<style>
  .toggle {
    border: 1px solid #eee;
    border-radius: 8px;
    overflow: hidden;
    padding: 0.25em;
    position: relative;
    display: inline-flex; /* 1. Keeps buttons inline and lets container wrap them tightly */
  }
  button {
    font-size: 1em;
    background: none;
    border: none;
    padding: 0.25em 0.55em;
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
    position: relative; /* 2. Ensures buttons sit on top of the background floater */
    z-index: 1;
  }
  /* Remove background-color from button.active so it doesn't clash with the floater */
  .toggleFloater {
    position: absolute;
    top: 0;
    left: 0;
    background-color: #f4f4f4;
    border-radius: 0.25em;
    /* 3. Define the transition permanently here, only animating transform and width */
    transition: transform 0.2s ease, width 0.2s ease; 
    pointer-events: none; /* Stops the floater from blocking button clicks */
  }
</style>

<script>
  // Scope the query selectors to this specific component instance if you have multiple on a page
  const toggles = document.querySelectorAll(".toggle");

  toggles.forEach((toggle) => {
    const buttons = toggle.querySelectorAll(".toggleButton");
    const floater = toggle.querySelector(".toggleFloater");
    let activeButton = toggle.querySelector(".toggleButton.active");

    // Initialize the floater position immediately on load
    if (activeButton && floater) {
      floater.style.width = `${activeButton.clientWidth}px`;
      floater.style.height = `${activeButton.clientHeight}px`;
      floater.style.transform = `translate(${activeButton.offsetLeft}px, ${activeButton.offsetTop}px)`;
      
      // Remove active class from button so only the floater provides the background
      activeButton.classList.remove("active"); 
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!floater) return;
        
        // Simply animate to the clicked button's dimensions
        floater.style.transform = `translate(${button.offsetLeft}px, ${button.offsetTop}px)`;
        floater.style.width = `${button.clientWidth}px`;
        floater.style.height = `${button.clientHeight}px`;
      });
    });
  });
</script>
