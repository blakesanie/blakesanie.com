---
interface Props {
  actions: { id: string; label: string }[];
  defaultAction?: string;
  id?: string;
}

const { actions, defaultAction } = Astro.props as Props;
// console.log(actions);
---

<div class="toggle" {...Astro.props}>
  <div class="toggleFloater"></div>
  {
    actions.map(({ id, label }) => {
      return (
        <button
          class:list={["toggleButton", { active: id == defaultAction }]}
          id={id}
        >
          {label}
        </button>
      );
    })
  }
</div>

<style>
  .toggle {
    border: 1px solid #eee;
    border-radius: 8px;
    overflow: hidden;
    padding: 0.25em;
    position: relative;
    display: inline-flex; /* 1. Keeps buttons inline and lets container wrap them tightly */
  }
  button {
    font-size: 1em;
    background: none;
    border: none;
    padding: 0.25em 0.55em;
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
    position: relative; /* 2. Ensures buttons sit on top of the background floater */
    z-index: 1;
  }
  .toggle:not(.ready) .toggleButton.active {
    background-color: #f4f4f4;
    border-radius: 0.25em;
  }
  /* Remove background-color from button.active so it doesn't clash with the floater */
  .toggleFloater {
    position: absolute;
    top: 0;
    left: 0;
    background-color: #f4f4f4;
    border-radius: 0.25em;
    /* 3. Define the transition permanently here, only animating transform and width */
    pointer-events: none; /* Stops the floater from blocking button clicks */
    visibility: hidden;
  }
  .toggle.ready .toggleFloater {
    visibility: visible;
    transition: transform 0.2s ease, width 0.2s ease;
  }
</style>

<script>
  // Scope the query selectors to this specific component instance if you have multiple on a page
  const toggles = document.querySelectorAll(".toggle");

  toggles.forEach((toggle) => {
    const buttons = toggle.querySelectorAll<HTMLButtonElement>(".toggleButton");
    const floater = toggle.querySelector<HTMLElement>(".toggleFloater");
    const activeButton = toggle.querySelector<HTMLButtonElement>(".toggleButton.active");

    function positionFloater(button: HTMLButtonElement) {
      if (!floater) return;
      floater.style.transform = `translate(${button.offsetLeft}px, ${button.offsetTop}px)`;
      floater.style.width = `${button.clientWidth}px`;
      floater.style.height = `${button.clientHeight}px`;
    }

    // Initialize the floater position immediately on load
    if (activeButton) positionFloater(activeButton);

    requestAnimationFrame(() => toggle.classList.add("ready"));

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        positionFloater(button);
      });
    });

    window.addEventListener("toggle-action", (event) => {
      const detail = (event as CustomEvent<{ actionId?: string; toggleId?: string }>).detail;
      if (!detail || detail.toggleId !== toggle.getAttribute("id")) return;

      const action = Array.from(buttons).find((button) => button.id === detail.actionId);
      if (action) positionFloater(action);
    });
  });
</script>
