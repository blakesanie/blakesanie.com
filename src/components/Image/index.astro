---
import { getImage } from "astro:assets";
import { getImageColors, getImageBlurPlaceholders } from "astro-image-pipeline"; // Adjust this import path to your setup

interface Props {
  src: any; // Accepts Astro image imports or remote URLs
  alt: string;
  width?: number;
  height?: number;
  quality?: string | number;
  format?: string;
  placeholder?: "color" | "blur" | "none";
  class?: string;
  style?: string | Record<string, any>;
  [key: string]: any;
}

const {
  src,
  alt,
  width,
  widths,
  height,
  quality,
  format,
  placeholder = "none",
  class: className,
  style = {},
  ...rest
} = Astro.props;

let placeholderStyle: Record<string, string> = {};
let imageAttrs: any = {};

try {
  // 1. Resolve the underlying reference path
  let resolvedSrc = src;
  if (src instanceof Promise) {
    resolvedSrc = await src;
  }

  const filepath =
    typeof resolvedSrc === "string"
      ? resolvedSrc
      : resolvedSrc.fsPath || resolvedSrc.default?.fsPath || resolvedSrc.src;

  // 2. Offload image asset processing to Astro's build engine
  const optimizedImage = await getImage({
    src,
    width,
    height,
    quality,
    format,
    widths,
  });

  imageAttrs = {
    src: optimizedImage.src,
    srcSet: optimizedImage.srcSet.attribute,
    ...optimizedImage.attributes,
  };

  // 3. Delegate placeholder operations to the parallelized disk cache pipeline
  if (placeholder === "color") {
    const colorMap = await getImageColors([filepath]);
    const dominant = colorMap[filepath];

    if (dominant) {
      placeholderStyle = {
        "background-color": `rgb(${dominant.r}, ${dominant.g}, ${dominant.b})`,
      };
    } else {
      console.error(
        "[Image Component] Failed to get dominant color for",
        filepath,
      );
    }
  } else if (placeholder === "blur") {
    const blurMap = await getImageBlurPlaceholders([filepath]);
    const base64Uri = blurMap[filepath];

    if (base64Uri) {
      placeholderStyle = {
        "background-image": `url(${base64Uri})`,
        "background-size": "cover",
        "background-position": "center",
      };
    } else {
      console.error(
        "[Image Component] Failed to get blur placeholder for",
        filepath,
      );
    }
  }
} catch (error) {
  console.error(
    "[Image Component] Failed to seamlessly process image assets:",
    error,
  );
}

// Map string style declarations safely into explicit key-value pairings
const incomingStyle =
  typeof style === "string"
    ? Object.fromEntries(
        style
          .split(";")
          .filter(Boolean)
          .map((s) => s.split(":").map((str) => str.trim())),
      )
    : style;

const combinedStyle = {
  ...placeholderStyle,
  ...incomingStyle,
};
---

<img
  alt={alt}
  class:list={[
    "smart-image",
    placeholder === "blur" && "smooth-blur",
    className,
  ]}
  style={combinedStyle}
  {...imageAttrs}
  {...rest}
/>

<style>
  .smart-image {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .smooth-blur {
    backdrop-filter: blur(12px);
    transform: translateZ(0);
  }
</style>
