---
import { getImage } from "astro:assets";
import {
  getImageColors,
  getImageBlurPlaceholders,
} from "vite-image-pipeline";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type SrcType =
  | string
  | ImageMetadata
  | { default: ImageMetadata }
  | Promise<{ default: ImageMetadata }>;

type NativeImageProps = Omit<
  HTMLAttributes<"img">,
  "alt" | "class" | "src" | "style" | "width" | "height"
>;

interface Props extends NativeImageProps {
  src: SrcType;
  filepath?: string;
  alt: string;
  width?: number;
  height?: number;
  widths?: number[];
  breakpoints?: number[];
  quality?: string | number;
  format?: string;
  placeholder?: "color" | "blur" | "none";
  placeholderColor?: { r: number; g: number; b: number };
  class?: string;
  style?: string | Record<string, string | number>;
}

const {
  src,
  filepath,
  alt,
  width,
  widths,
  breakpoints,
  height,
  quality,
  format,
  placeholder = "none",
  placeholderColor,
  class: className,
  style = {},
  ...rest
} = Astro.props;

let placeholderStyle: Record<string, string> = {};
let imageAttrs: Record<string, unknown> = {};

async function srcToImageMetadata(src: SrcType): Promise<ImageMetadata | null> {
  if (typeof src === "string") {
    return null;
  }
  if (src instanceof Promise) {
    return srcToImageMetadata(await src);
  }
  if (typeof src === "object") {
    if ("default" in src) {
      return src.default;
    } else if ("src" in src) {
      return src;
    }
    return null;
  }
  throw Error("<Image> src input invalid: " + src);
}

try {
  // 1. Resolve the underlying reference path

  let w = width;
  let h = height;
  let srcString = typeof src == "string" ? src : null;
  let imageMetadata = await srcToImageMetadata(src);
  if (imageMetadata) {
    if (w) w = Math.min(w, imageMetadata.width);
    if (h) h = Math.min(h, imageMetadata.height);
  }
  let finalSrc = srcString || imageMetadata;
  if (!finalSrc) throw Error("<Image> src input empty: " + src);
  // 2. Offload image asset processing to Astro's build engine
  const optimizedImage = await getImage({
    src: finalSrc,
    width: w,
    height: h,
    quality,
    format,
    widths: widths ?? breakpoints,
  });

  imageAttrs = {
    src: optimizedImage.src,
    srcSet: optimizedImage.srcSet.attribute,
    ...optimizedImage.attributes,
  };
  // 3. Delegate placeholder operations to the parallelized disk cache pipeline
  if (placeholder === "color") {
    if (!filepath && !placeholderColor) {
      throw Error("[Image Component] filepath missing for color placeholder");
    }
    const colorMap = filepath && !placeholderColor ? await getImageColors([filepath]) : {};
    const dominant = placeholderColor || (filepath ? colorMap[filepath] : undefined);
    if (dominant) {
      placeholderStyle = {
        "background-color": `rgb(${dominant.r}, ${dominant.g}, ${dominant.b})`,
      };
    } else {
      console.error("[Image Component] Failed to get dominant color for", filepath);
    }
  } else if (placeholder === "blur") {
    if (!filepath)
      throw Error(
        "[Image Component] filepath missing for blur placeholder: " +
          JSON.stringify(Astro.props, null, 2),
      );
    const blurMap = await getImageBlurPlaceholders([filepath]);
    const base64Uri = blurMap[filepath];

    if (base64Uri) {
      placeholderStyle = {
        "background-image": `url(${base64Uri})`,
        "background-size": "cover",
        "background-position": "center",
      };
    } else {
      console.error("[Image Component] Failed to get blur placeholder for", filepath);
    }
  }
} catch (error) {
  throw Error("[Image Component] Failed to seamlessly process image assets: " + error);
}

// Map string style declarations safely into explicit key-value pairings
const incomingStyle =
  typeof style === "string"
    ? Object.fromEntries(
        style
          .split(";")
          .filter(Boolean)
          .map((s) => s.split(":").map((str) => str.trim())),
      )
    : style;

const combinedStyle = {
  ...placeholderStyle,
  ...incomingStyle,
};
---

<img
  alt={alt}
  class:list={["smart-image", placeholder === "blur" && "smooth-blur", className]}
  style={combinedStyle}
  {...imageAttrs}
  {...rest}
/>

<style>
  .smart-image {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .smooth-blur {
    backdrop-filter: blur(12px);
    transform: translateZ(0);
  }
</style>
