---
// @ts-ignore
import Image from "./Image/index.astro";
import SmartHref from "./HeaderAndFooter/SmartHref.astro";

interface LinkInterface {
  target: string;
  href: string;
  label: string;
  class?: string;
}

const links: LinkInterface[] = Astro.props.links;
let { text, imageSrc, style, class: className, ...props } = Astro.props;
const maxImageOpacity = 0.5;
---

<div style={{ ...style }} class:list={["section", className]} {...props}>
  {
    imageSrc && (
      <Image
        placeholder="blur"
        src={imageSrc}
        alt=""
        loading="lazy"
        widths={[400, 800, 1200, 1600, 2000]}
        sizes="100vw"
        quality={75}
        format="webp"
        class="bg"
      />
    )
  }
  {text && <h2>{text}</h2>}
  {
    links && (
      <div class="links">
        {links.map(({ target, href, label, ...props }) => {
          return (
            <SmartHref
              href={href}
              target={target}
              class:list={[props.class, "link"]}
            >
              {label}
            </SmartHref>
          );
        })}
      </div>
    )
  }
  <slot />
</div>

<style is:global>
  main {
    margin-left: 0 !important;
  }
  header::before {
    content: "";
    position: fixed;
    width: var(--headerWidth);
    height: 100%;
    top: 0;
    left: 0;
    backdrop-filter: blur(5px);
  }

  footer {
    max-height: 0;
  }

  footer > div {
    position: absolute !important;
  }
</style>

<style>
  .section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-left: var(--headerWidth);
  }
  @media screen and (max-width: 800px) {
    .section {
      padding-left: 0;
    }
  }

  /* Target the native background class directly */
  .bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    opacity: 0.6;
    z-index: 0; /* Ensures backdrop layout order stays beneath headings */
  }

  h2 {
    font-size: 2.7em;
    text-align: center;
    padding: 0 2em;
    z-index: 1;
  }
  .links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    padding: 0.5em;
    margin-top: 1em;
    z-index: 1;
  }
  .link {
    text-align: center;
    font-size: 1.3em;
    margin: 0.5em;
    background-color: rgba(255, 255, 255, 0.2);
    padding: 0.5em 1em;
    backdrop-filter: blur(5px);
    border-radius: 8px;
    transition: background-color 0.1s ease;
  }
  .link:hover {
    background-color: rgba(0, 0, 0, 0.2);
  }
</style>
