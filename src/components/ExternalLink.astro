---
interface Props {
  href: string;
  class?: string;
  id?: string;
  ariaLabel?: string;
}

const { href, class: className, id, ariaLabel } = Astro.props;
---

<a
  href={href}
  class={className}
  id={id}
  aria-label={ariaLabel}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
</a>
