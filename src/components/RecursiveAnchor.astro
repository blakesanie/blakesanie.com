---
interface AnchorTree {
  [key: string]: string | AnchorTree;
}

interface Props {
  tree: AnchorTree;
}

const links = [];
const dirs = [];
for (const pair of Object.entries(Astro.props.tree)) {
  const [key, value] = pair;
  if (typeof value == "string") {
    links.push({
      name: key,
      href: value,
    });
  } else {
    dirs.push({
      name: key,
      tree: value,
    });
  }
}
links.sort((a, b) => {
  return a.name.localeCompare(b.name);
});
dirs.sort((a, b) => {
  return a.name.localeCompare(b.name);
});
---

{
  links.map(({ name, href }) => {
    return (
      <a href={href} target="_blank">
        {name}
      </a>
    );
  })
}
{
  dirs.map(({ name, tree }) => {
    return (
      <div>
        {name}
        <Astro.self tree={tree} />
      </div>
    );
  })
}
