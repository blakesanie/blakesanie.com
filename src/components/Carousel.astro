---
interface Props {
  /** Optional class for styling the carousel from the consuming page. */
  class?: string;
  /** Approximate animation speed in pixels per second when content overflows. */
  speed?: number;
}

const { class: className, speed = 40 } = Astro.props;
const animationSpeed = Number.isFinite(speed) && speed > 0 ? speed : 40;
---

<div
  class:list={["carousel", className]}
  data-carousel
  data-carousel-speed={animationSpeed}
>
  <div class="carousel__track">
    <slot />
  </div>
</div>

<style>
  .carousel {
    width: 100%;
    overflow: hidden;
  }

  .carousel__track {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    min-width: 100%;
    align-items: center;
  }

  .carousel__track > * {
    flex: 0 0 auto;
  }

  .carousel[data-carousel-overflowing="true"] .carousel__track {
    will-change: transform;
    animation: carousel-scroll var(--carousel-duration) linear infinite;
  }

  .carousel[data-carousel-overflowing="true"]:hover .carousel__track {
    animation-play-state: paused;
  }

  @keyframes carousel-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(calc(-1 * var(--carousel-distance)), 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel[data-carousel-overflowing="true"] .carousel__track {
      animation: none;
    }
  }
</style>

<script>
  const initializedCarousels = new WeakSet<HTMLElement>();

  const initializeCarousel = (carousel: HTMLElement) => {
    if (initializedCarousels.has(carousel)) return;
    initializedCarousels.add(carousel);

    const track = carousel.querySelector<HTMLElement>(".carousel__track");
    if (!track) return;

    let lastContentWidth = 0;
    let lastContainerWidth = 0;

    const update = () => {
      // Measure originals only. Rebuilding clones for every iOS resize event
      // continually restarts the animation at frame zero.
      const originalChildren = Array.from(track.children).filter(
        (child) => !child.hasAttribute("data-carousel-clone"),
      );
      const childWidth = originalChildren.reduce(
        (total, child) => total + child.getBoundingClientRect().width,
        0,
      );
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      const originalWidth = childWidth + gap * Math.max(0, originalChildren.length - 1);
      const containerWidth = carousel.clientWidth;

      if (
        Math.abs(originalWidth - lastContentWidth) < 1 &&
        Math.abs(containerWidth - lastContainerWidth) < 1
      ) return;

      track.querySelectorAll<HTMLElement>("[data-carousel-clone]").forEach((clone) => clone.remove());
      carousel.removeAttribute("data-carousel-overflowing");
      track.style.removeProperty("--carousel-distance");
      track.style.removeProperty("--carousel-duration");
      track.style.removeProperty("transform");

      if (originalWidth <= containerWidth + 1) {
        lastContentWidth = originalWidth;
        lastContainerWidth = containerWidth;
        return;
      }

      // A second copy makes the end of one pass identical to the beginning of the next.
      originalChildren.forEach((child) => {
        const clone = child.cloneNode(true) as HTMLElement;
        clone.setAttribute("data-carousel-clone", "true");
        clone.setAttribute("aria-hidden", "true");
        track.append(clone);
      });

      const speed = Number(carousel.dataset.carouselSpeed) || 40;
      track.style.setProperty("--carousel-distance", `${originalWidth}px`);
      track.style.setProperty("--carousel-duration", `${originalWidth / speed}s`);
      carousel.dataset.carouselOverflowing = "true";
      lastContentWidth = originalWidth;
      lastContainerWidth = containerWidth;
    };

    const observer = new ResizeObserver(update);
    observer.observe(carousel);
    track.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
      image.addEventListener("load", update);
    });
    update();
  };

  const initializeCarousels = () =>
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(initializeCarousel);

  initializeCarousels();
  document.addEventListener("astro:page-load", initializeCarousels);
</script>
