---
import { SEO } from "astro-seo";
import RemoveLogs from "../basic/RemoveLogs.astro";
import satori from "satori";
import { Resvg } from "@resvg/resvg-js";
import fs from "fs";
import { getImage } from "astro:assets";
import path from "node:path";
import sharp from "sharp";
import type { ImageMetadata } from "astro";

interface Props {
  /** Page title, appended with the site name for SEO metadata. */
  title?: string;
  /** Optional source image used to generate the Open Graph image. */
  image?: string | ImageMetadata;
  imageAlt?: string;
  description?: string;
  noIndex?: boolean;
  noFollow?: boolean;
  redirect?: boolean;
  themeColor?: string;
  /** Class-list value forwarded to the document body. */
  bodyClasslist?: Record<string, boolean> | Record<string, boolean>[];
}

const props = Astro.props;

const title = props.title ? props.title + " | Blake Sanie" : "Blake Sanie";

let image: { src: string } | null = null;
  if (props.image) {
  image = await getImage({
    src: props.image,
    width: 1200,
    format: "webp",
    quality: 75,
  });
} else {
  const font = fs.readFileSync("public/fonts/assistant-regular.ttf");
  const font2 = fs.readFileSync("public/fonts/assistant-semibold.ttf");
  const ogBg = fs.readFileSync("src/assets/portfolio_alias/Manhattan Bridge.jpg");
  const b64 = ogBg.toString("base64");

  const arrowSvg = props.redirect
    ? {
        type: "svg",
        props: {
          xmlns: "http://www.w3.org/2000/svg",
          viewBox: "0 0 24 24",
          children: {
            type: "path",
            props: {
              fill: "white",
              d: "M6.4 18L5 16.6L14.6 7H6V5h12v12h-2V8.4z",
            },
          },
          width: 60,
          height: 60,
          style: { opacity: 0.5, marginTop: 30, marginLeft: -4 },
        },
      }
    : "";

  const width = 1200;
  const height = 900;
  const quality = 75;

  const svg = await satori(
    {
      type: "div",
      props: {
        children: [
          {
            type: "img",
            props: {
              src: `data:image/jpeg;base64,${b64}`,
              style: { transform: `scale(1.2) translate(8%,6%)` },
            },
          },
          {
            type: "div",
            props: {
              children: [
                {
                  type: "div",
                  props: {
                    children: [props.title || "Blake Sanie", arrowSvg],
                    style: { display: "flex" },
                  },
                },
                {
                  type: "div",
                  props: {
                    children: props.title
                      ? "Blake Sanie"
                      : [
                          "Software Engineer. Photographer.",
                          {
                            type: "div",
                            props: { children: "Ironman. Lifelong Student." },
                          },
                        ],
                    style: {
                      display: "flex",
                      flexDirection: "column",
                      fontSize: props.title ? 60 : 40,
                      opacity: 0.4,
                      fontWeight: 400,
                    },
                  },
                },
              ],
              style: {
                display: "flex",
                flexDirection: "column",
                position: "absolute",
                top: 50,
                left: 70,
                color: "white",
                fontSize: 120,
                maxWidth: 1200 - 50 * 2,
                fontWeight: 700,
                gap: -8,
              },
            },
          },
        ],
        style: {
          display: "flex",
          background: "black",
          width: "100%",
          height: "100%",
        },
      },
    } as any,
    {
      width: width,
      height: height,
      fonts: [
        { name: "Assistant", data: font, weight: 400, style: "normal" },
        { name: "Assistant", data: font2, weight: 700, style: "normal" },
      ],
    },
  );

  const resvg = new Resvg(svg, { fitTo: { mode: "width", value: 1200 } });
  const pngBuffer = resvg.render().asPng();

  // 1. Sanitize the title for a safe URL filename
  const safeTitle = props.title
    ? props.title.replace(/\s+/g, "-").replace(/[^a-zA-Z0-9-]/g, "")
    : "default";
  const filename = `${safeTitle}-og.webp`;

  // 2. Compress the PNG buffer straight to webp using Sharp
  const buffer = await sharp(pngBuffer).resize(width, height).webp({ quality: quality }).toBuffer();

  const isProd = import.meta.env.PROD;
  const targetDir = isProd
    ? path.join(process.cwd(), "dist", "og-images") // Production build output
    : path.join(process.cwd(), "public", "og-images"); // Local development fallback

  // 2. Ensure the directory exists and save the file
  if (!fs.existsSync(targetDir)) {
    fs.mkdirSync(targetDir, { recursive: true });
  }
  fs.writeFileSync(path.join(targetDir, filename), buffer);

  // 3. Keep the browser image source path identical for both
  image = {
    src: `/og-images/${filename}`,
  };
}

const { noIndex } = props;

const imageAlt = props.imageAlt || "Open Graph Thumbnail Image for blakesanie.com";
const description =
  props.description || "Software Engineer. Photographer. Ironman. Lifelong Student.";
---

<html lang="en">
  <head>
    <RemoveLogs />

    <!-- <meta charset="utf-8" /> -->
    <!-- <meta viewport="width=device-width, initial-scale=1" /> -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <SEO
      title={title}
      description={description}
      noindex={noIndex ? true : false}
      nofollow={props.noFollow ? props.noFollow : noIndex ? true : false}
      charset="utf-8"
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: image.src,
        },
        optional: {
          description: description,
        },
        image: {
          type: "image/" + image?.src?.split(".").pop()?.split("?")[0],
          alt: imageAlt,
        },
      }}
      extend={{}}
    />
    <meta name="google-site-verification" content="ePB1GvvA8L5Hza96sGcmDLw_jIzjhQ2JhXbIAg_8hlA" />
    <meta name="theme-color" content={props.themeColor} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="apple-touch-icon-precomposed"
      sizes="57x57"
      href="/favicons/apple-touch-icon-57x57.png"
    />
    <link
      rel="apple-touch-icon-precomposed"
      sizes="114x114"
      href="/favicons/apple-touch-icon-114x114.png"
    />
    <link
      rel="apple-touch-icon-precomposed"
      sizes="72x72"
      href="/favicons/apple-touch-icon-72x72.png"
    />
    <link
      rel="apple-touch-icon-precomposed"
      sizes="144x144"
      href="/favicons/apple-touch-icon-144x144.png"
    />
    <link
      rel="apple-touch-icon-precomposed"
      sizes="60x60"
      href="/favicons/apple-touch-icon-60x60.png"
    />
    <link
      rel="apple-touch-icon-precomposed"
      sizes="120x120"
      href="/favicons/apple-touch-icon-120x120.png"
    />
    <link
      rel="apple-touch-icon-precomposed"
      sizes="76x76"
      href="/favicons/apple-touch-icon-76x76.png"
    />
    <link
      rel="apple-touch-icon-precomposed"
      sizes="152x152"
      href="/favicons/apple-touch-icon-152x152.png"
    />
    <link rel="icon" type="image/png" href="/favicons/favicon-196x196.png" sizes="196x196" />
    <link rel="icon" type="image/png" href="/favicons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="/favicons/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicons/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicons/favicon-128.png" sizes="128x128" />
    <meta name="application-name" content=" " />
    <meta name="msapplication-TileColor" content="#FFFFFF" />
    <meta name="msapplication-TileImage" content="/favicons/mstile-144x144.png" />
    <meta name="msapplication-square70x70logo" content="/favicons/mstile-70x70.png" />
    <meta name="msapplication-square150x150logo" content="/favicons/mstile-150x150.png" />
    <meta name="msapplication-wide310x150logo" content="/favicons/mstile-310x150.png" />
    <meta name="msapplication-square310x310logo" content="/favicons/mstile-310x310.png" />

    <Fragment
      set:html={`<script type="application/ld+json">{
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Blake Sanie",
      "url": "https://blakesanie.com",
      "sameAs": [
        "https://linkedin.com/in/blakesanie/","https://blakesanie.substack.com","https://instagram.com/blake_sanie/",""
       ]
    }</script>`}
    />
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=UA-164774604-1"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args: unknown[]) {
        window.dataLayer.push(args);
      }
      gtag("js", new Date());

      gtag("config", "UA-164774604-1");
    </script>
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <slot name="head" />
  </head>

  <!-- <Fragment set:html={svg} /> -->
  <body class:list={props.bodyClasslist}><slot /></body>
</html>
