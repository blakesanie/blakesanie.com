---
import redirects from "../../redirects.json";
import type { RedirectMap } from "../../types/redirects";

interface Props {
  href: string;
  target?: string;
  id?: string;
  class?: string;
  [key: string]: unknown;
}

const { href, ...attributes } = Astro.props;
const key = href.substring(1) as string;
const fullHref = (redirects as RedirectMap)[key]?.href;
---

<a {...attributes} href={fullHref || href}>
  <slot />
</a>
