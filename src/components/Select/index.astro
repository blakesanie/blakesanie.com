---
interface Props {
    label: string,
    options: string[],
    initial?: string
}

const { label, options, initial } = Astro.props;
---

<div class="select">
    <label>{label}</label>
    <select>
        {
            options.map(option => (
                <option value={option} selected={option === initial}>
                    {option}
                </option>
            ))
        }
    </select>
</div>

<style>
    div {
        /* box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.1); */
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 0.25em;
        position: relative;
        padding-right: 0.25em;
        /* width: 100%; */
    }
    select {
        font-size: 1em;
        background: none;
        border: none;
        padding: 0.25em;
        cursor: pointer;
        /* width: 100%; */
    }
    select:focus {
        outline: none;
    }
    label {
        position: absolute;
        top: 0;
        left: 0.72em;
        transform: translateY(-50%);
        background-color: white;
        font-size: 0.8em;
        padding: 0 0.3em;
        color: #bbb;
        font-weight: 400;
    }
</style>
