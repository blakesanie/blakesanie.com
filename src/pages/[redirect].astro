---
import redirects from "../redirects.json";
import HeaderAndFooter from "../components/HeaderAndFooter/index.astro";
import type { RedirectMap } from "../types/redirects";

export function getStaticPaths() {
  return Object.keys(redirects).map((endpoint) => {
    return {
      params: {
        redirect: endpoint,
      },
    };
  });
}

const { redirect } = Astro.params;
const redirectData = redirect ? (redirects as RedirectMap)[redirect] : undefined;
if (!redirectData) return Astro.redirect("/");
const { title, href, short } = redirectData;
---

<HeaderAndFooter
  allowMainStyles
  title={short || title}
  description={`Redirect to ${title}, found at ${href}`}
  noIndex
  hideSpotify
  pageNotInNav
>
  <meta http-equiv="refresh" content={`0; url=${href}`} slot="head" />
  <h1>Redirecting to {title}</h1>
</HeaderAndFooter>

<script is:inline
  define:vars={{
    href: href,
  }}
>
  window.location.href = href;
</script>
