---
import PortfolioPage from "./index.astro";
import exiftoolJson from "../../assets/photo-portfolio/temp/blake/metadata.json";
import { cleanseName } from "./_utils";

export async function getStaticPaths() {
  const glob = import.meta.glob("/src/assets/photo-portfolio/temp/blake/*.jpg", { eager: true });
  return (
    await Promise.all(
      Object.keys(glob)
        .map(async (path) => {
          const filename = path.split("/").pop();
          const name = filename?.split(".").slice(0, -1).join(".");
          if (!name || !filename) throw new Error(`No filename found for path: ${path}`);
          const meta = exiftoolJson[filename];
          if (!meta) throw new Error(`No metadata found for ${filename}`);

          return [
            {
              params: {
                slug: cleanseName(name),
              },
              props: {
                image: `/og/photo/blake/${encodeURIComponent(name)}.webp`,
                imageName: name,
              },
            },
          ];
        }),
    )
  ).flat();
}
---

<PortfolioPage image={Astro.props.image} imageName={Astro.props.imageName} />
