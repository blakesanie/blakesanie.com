---
import PortfolioPage from "./index.astro";
import { cleanseName } from "./_utils";
import path from "path";
import { getCachedPortfolioAssetGlob } from "./_galleryCache";

export function getStaticPaths() {
  const assetGlob = getCachedPortfolioAssetGlob();

  return Object.keys(assetGlob).map((filePath) => {
    const fileName = path.basename(filePath);
    const name = fileName.split(".").slice(0, -1).join(".");
    return {
      params: {
        slug: cleanseName(name),
      },
      props: {
        imageName: name,
        filename: fileName, // Pass down the raw filename instead of processing the image here
      },
    };
  });
}

const { imageName, filename } = Astro.props;
---

<PortfolioPage image={filename} imageName={imageName} />
