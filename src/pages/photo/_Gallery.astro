    }

    const thumbImg = activeGalleryImg.querySelector(
      "img.thumb-img",
    ) as HTMLImageElement;

    if (isMapView) {
      // --- STRICT FADE-OUT FOR MAP VIEW ---
      fullScreenEl.classList.remove("active");

      if (fullScreenImage) {
        // fullScreenImage.style.opacity = "0";
        fullScreenImage.setAttribute("data-loading-src", "");
