<script>
  import { cleanseName, dotProduct } from "./_utils";

    // --- Browser Load Time Randomization ---
  const galleryImages = document.querySelectorAll(".galleryImage");
  const galleryContainer = document.getElementById("gallery");

  const shouldRandomize = galleryContainer!.classList.contains("toShuffle")

  if (shouldRandomize && galleryImages.length > 0) {
    // Convert NodeList to a standard array for shuffling
    const itemsArray = Array.from(galleryImages);

    // Fisher-Yates Shuffle algorithm
    for (let i = itemsArray.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [itemsArray[i], itemsArray[j]] = [itemsArray[j], itemsArray[i]];
    }

    // Append elements back into the DOM in their new random order
    itemsArray.forEach((item) => {
      galleryContainer!.appendChild(item);
    });
  }

  // Reveal the gallery now that shuffling is complete
  galleryContainer!.classList.remove("toShuffle");




