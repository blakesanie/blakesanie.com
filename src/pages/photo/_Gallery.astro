---
import HeaderAndFooter from "../../components/HeaderAndFooter/index.astro";
import { getImage } from "astro:assets";
import Image from "../../components/Image/index.astro";
import MapGallery from "./_MapGallery.astro";
import { encodeEmbeddings } from "./_utils";
import Toggle from "../../components/Toggle/index.astro";
import TextInput from "../../components/TextInput/index.astro";
import { getImageMetadata, getImageEmbeddings } from "astro-image-pipeline";
import path from "path";
import type { ImageMetadata as AstroImageMetadata } from "astro";
import { getSharedProcessedImage, getSharedMapImage } from "./_galleryCache";

export interface Props {
  assetGlob: Record<string, { default: AstroImageMetadata }>;
  image?: string;
  imageName?: string;
  initialMode?: string;
  allowFullscreen?: boolean;
  allowMetadata?: boolean;
  allowMap?: boolean;
  allowClip?: boolean;
  randomize?: boolean;
  heading?: string;
  subheading?: string;
  allowDownload?: boolean;
  allowFilename?: boolean;
  allowBlog?: boolean;
  allowUniqueUrls?: boolean;
  title?: string;
  description?: string;
}

const {
  heading = "Photography",
  subheading,
  initialMode = "gallery",
  allowMap = false,
  allowFullscreen = false,
  allowMetadata = false,
  allowClip = false,
  allowFilename = false,
} = Astro.props;

// const filePaths = Object.keys(Astro.props.assetGlob).map((vitePath) =>
//   path.resolve(path.join(process.cwd(), vitePath)),
// );

let metadata: Record<string, Record<string, any>> | null = null;
if (allowMetadata) {
  metadata = await getImageMetadata(Object.keys(Astro.props.assetGlob));
  console.log("collected metadata");
}

let embeddings: Record<string, number[]> | null = null;
if (allowClip) {
  embeddings = await getImageEmbeddings(Object.keys(Astro.props.assetGlob));
  console.log("collected embeddings");
}

const lensReplacements: Record<string, string> = {
  "AF-S DX VR Zoom-Nikkor 18-105mm f/3.5-5.6G ED":
    "Nikon 18-105mm f/3.5-5.6G DX",
  "Tamron 20-40mm F2.8 Di III VXD": "Tamron 20-40mm F2.8",
  "FE 28-70mm F3.5-5.6 OSS": "Sony 28-70mm F3.5-5.6",
  "AF-S DX Nikkor 35mm f/1.8G": "Nikon 35mm f/1.8G DX",
  "SAMYANG AF 24mm F2.8": "Rokinon 24mm F2.8",
  "Tamron 70-300mm F4.5-6.3 Di III RXD": "Tamron 70-300mm F4.5-6.3",
  "----": "Helios 44/2",
};

const cameraReplacements: Record<string, string> = {
  "ILCE-7C": "Sony a7C",
  "NIKON D3200": "Nikon D3200",
  "ILCE-7": "Sony a7",
  FC3682: "DJI Mini 3",
};

function resolveCamera(exif: Record<string, any>) {
  for (const x of ["model", "CameraModelName", "Model"]) {
    if (exif[x] && cameraReplacements[exif[x]])
      return cameraReplacements[exif[x]];
  }
}

function resolveLens(exif: Record<string, any>) {
  for (const x of ["Lens", "LensModel", "LensSpec"]) {
    if (exif[x] && lensReplacements[exif[x]]) return lensReplacements[exif[x]];
  }
}

function resolveShutter(exif: Record<string, any>) {
  let x = exif["ExposureTime"];
  if (x) return x;
}

function resolveAperture(exif: Record<string, any>): number | undefined {
  const x = exif["FNumber"];
  if (!x) return undefined;
  let n;
  if (typeof x == "string") {
    n = parseFloat(x);
  } else if (typeof x == "number") {
    n = x;
  }
  if (n === undefined) {
    console.log(exif);
    console.log("FNumber is not numerical: " + x);
    return undefined;
  }

  if (Math.round(n) === n) {
    return Math.round(n);
  }
  return n;
}

function resolveFocalLength(exif: Record<string, any>): number | undefined {
  const focal = exif["FocalLengthIn35mmFormat"];
  if (focal) {
    if (typeof focal == "number") {
      return focal;
    }
    return parseFloat(focal);
  }
}

// function dmsToDecimal(dmsStr: string) {
//   if (!dmsStr) return null;
//   const regex = /(\d+)\s*deg\s*(\d+)'\s*([\d.]+)"\s*([NSEW])/i;
//   const match = dmsStr.match(regex);
//   if (!match) return null;

//   const degrees = parseInt(match[1], 10);
//   const minutes = parseInt(match[2], 10);
//   const seconds = parseFloat(match[3]);
//   const direction = match[4].toUpperCase();

//   let decimal = degrees + minutes / 60 + seconds / 3600;
//   if (direction === "S" || direction === "W") decimal = -decimal;
//   return parseFloat(decimal.toFixed(6));
// }

interface ImageMetadata {
  camera?: string;
  lens?: string;
  focalLength?: number;
  aperture?: number;
  shutterSpeed?: string;
  iso?: number;
  lon?: number;
  lat?: number;
}

interface ImageData {
  filePath: string;
  name: string;
  src: any;
  width: number;
  height: number;
  highRes: string;
  aspectRatio: number;
  embeddings?: string;
  metadata?: ImageMetadata;
}

const imagesData = await Promise.all(
  Object.entries(Astro.props.assetGlob).map(async ([filePath, module]) => {
    return await getSharedProcessedImage({
      filePath,
      module,
      allowClip,
      allowMetadata,
      embeddings,
      metadata,
      resolveCamera,
      resolveLens,
      resolveFocalLength,
      resolveAperture,
      resolveShutter,
    });
  }),
);

// 🔥 MEMOIZED: Optimizes map thumbnails once
const mapImages = await Promise.all(
  imagesData
    .filter(
      (img) =>
        img.metadata?.lat !== undefined && img.metadata?.lon !== undefined,
    )
    .map(async (img) => await getSharedMapImage(img)),
);

let title = Astro.props.title ? Astro.props.title + " | Photo" : "Photography";
if (Astro.props.imageName) {
  title = Astro.props.imageName + " | " + title;
}

const description =
  Astro.props.description || "My portfolio of artistic photographs.";
const gutter = "10px";
console.log("end of Gallery frontmatter");
---

<HeaderAndFooter
  allowMainStyles
  mainClass={initialMode}
  color="#eeeeeed0"
  colorOpaque="rgb(241, 241, 241)"
  themeColor="#f0f0f0"
  darkText
  hoverZoneBehind
  noBackdropFilter
  flangeColor="white"
  title={title}
  description={description}
  image={Astro.props.image}
>
  {heading && <h1>{heading}</h1>}
  {subheading && <p set:html={subheading} />}
  <div id="controls">
    {
      allowMap && (
        <Toggle
          actions={[
            { id: "toggleGallery", label: "Gallery" },
            { id: "toggleMap", label: "Map" },
          ]}
          defaultAction={initialMode == "map" ? "toggleMap" : "toggleGallery"}
        />
      )
    }
    {
      allowClip && (
        <TextInput
          id="clip"
          label="AI Image Search"
          placeholder="Loading Model..."
          disabled
        />
      )
    }
    {
      allowFilename && (
        <TextInput
          id="nameSearch"
          label="Search By Name"
          placeholder="DSC0123"
        />
      )
    }
  </div>

  <div
    id="photoContent"
    class={`${allowMap ? "" : "noMap"} ${allowFullscreen ? "" : "noFullscreen"} view-${initialMode}`}
  >
    <div id="gallery">
      {
        imagesData.map((image) => {
          return (
            <div
              class="galleryImage"
              data-name={image.name}
              data-fullres={image.highRes}
              data-camera={image.metadata?.camera}
              data-lens={image.metadata?.lens}
              data-focal={image.metadata?.focalLength}
              data-aperture={image.metadata?.aperture}
              data-shutter={image.metadata?.shutterSpeed}
              data-iso={image.metadata?.iso}
              data-width={image.width}
              data-height={image.height}
              data-lat={image.metadata?.lat}
              data-lon={image.metadata?.lon}
              data-emb={image.embeddings}
              style={{
                flexGrow: image.aspectRatio,
                aspectRatio: image.aspectRatio,
                flexBasis: `calc(var(--base-height) * (${image.aspectRatio}))`,
                maxHeight: `calc(500px)`,
                maxWidth: `calc(500px * ${image.aspectRatio})`,
              }}
            >
              {/* <div class="astro-native-img-wrapper"> */}
              {/* Thumbnail */}
              <Image
                placeholder="color"
                src={image.src}
                alt={image.name || "Portfolio photograph"}
                width={Math.max(
                  600,
                  Math.round((500 / image.height) * image.width),
                )}
                quality={75}
                format="webp"
                loading="lazy"
                class="thumb-img"
              />
              {allowFilename && <div class="name-label">{image.name}</div>}
            </div>
          );
        })
      }
    </div>

    {allowMap && <MapGallery mapImages={mapImages} />}
  </div>

  {
    allowFullscreen && (
      <div id="fullscreenOverlay" role="dialog" aria-modal="true" tabindex="-1">
        <div id="fullscreenScroll">
          <div id="imageViewport">
            <div class="metadata-panel" id="metadataPanel">
              <div class="metadata-title" id="metaTitle" />
              <div class="metadata-chips-row" id="metaChipsRow" />
              <div class="metadata-actions">
                <div id="exitButton">Exit</div>
                <div id="prevButton">Prev</div>
                <div id="nextButton">Next</div>
              </div>
            </div>
            <img
              id="fullscreenPlaceholder"
              class="fullscreen-placeholder"
              alt=""
            />
          </div>
          <div id="viewportBelow">
            <div id="selectedMap" />
          </div>
        </div>
      </div>
    )
  }
</HeaderAndFooter>

