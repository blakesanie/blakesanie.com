---
import { execFile } from "child_process";
import HeaderAndFooter from "../../components/HeaderAndFooter/index.astro";
import { Image } from "astro:assets";

export interface Props {
  imagesData: any[];
  embeddingsJson?: Record<string, any>;
  image?: string;
  imageName?: string;
  initialMode?: string;
  allowFullscreen?: boolean;
  allowMap?: boolean;
  allowMetadata?: boolean;
  allowClip?: boolean;
  randomize?: boolean;
  heading?: string;
  subheading?: string;
  allowDownload?: boolean;
  allowFilename?: boolean;
  allowBlog?: boolean;
  allowUniqueUrls?: boolean;
  title?: string;
  description?: string;
}

const {
  imagesData = [],
  heading = "Photography",
  subheading,
  initialMode = "gallery",
  allowMap = false,
  allowFullscreen = false,
} = Astro.props;

const lensReplacements: Record<string, string> = {
  "AF-S DX VR Zoom-Nikkor 18-105mm f/3.5-5.6G ED":
    "Nikon 18-105mm f/3.5-5.6G DX",
  "Tamron 20-40mm F2.8 Di III VXD": "Tamron 20-40mm F2.8",
  "FE 28-70mm F3.5-5.6 OSS": "Sony 28-70mm F3.5-5.6",
  "AF-S DX Nikkor 35mm f/1.8G": "Nikon 35mm f/1.8G DX",
  "SAMYANG AF 24mm F2.8": "Rokinon 24mm F2.8",
  "Tamron 70-300mm F4.5-6.3 Di III RXD": "Tamron 70-300mm F4.5-6.3",
  "----": "Helios 44/2",
};

const cameraReplacements: Record<string, string> = {
  "ILCE-7C": "Sony a7C",
  "NIKON D3200": "Nikon D3200",
  "ILCE-7": "Sony a7",
  FC3682: "DJI Mini 3",
};

function resolveCamera(exif: Record<string, string>) {
  for (const x of ["model", "Camera Model Name", "Model"]) {
    if (exif[x] && cameraReplacements[exif[x]])
      return cameraReplacements[exif[x]];
  }
}

function resolveLens(exif: Record<string, string>) {
  for (const x of ["Lens ID", "Lens Model", "Lens Spec"]) {
    if (exif[x] && lensReplacements[exif[x]]) return lensReplacements[exif[x]];
  }
}

function resolveShutter(exif: Record<string, string>) {
  let x = exif["Exposure Time"];
  if (x) return x;
}

function resolveAperture(exif: Record<string, string>) {
  const x = exif["F Number"];
  if (x) {
    const n = parseFloat(x);
    if (Math.round(n) === n) {
      return Math.round(n);
    }
    return x;
  }
}

// Process the image items mapping dimensions and metadata dynamically
const galleryImages = imagesData.map((img) => {
  const { name, path: imageAsset, width, height, exif } = img;

  const aspectRatioNum = width && height ? width / height : 1;

  return {
    name,
    path: imageAsset,
    flexGrow: aspectRatioNum,
    aspectRatio: width && height ? `${width} / ${height}` : "auto",
    width,
    height,
    metadata: {
      camera: resolveCamera(exif),
      lens: resolveLens(exif),
      focalLength: exif["Focal Length In 35mm Format"],
      aperture: resolveAperture(exif),
      shutterSpeed: resolveShutter(exif),
      iso: exif.ISO,
    },
  };
});

console.log(galleryImages);

let title = Astro.props.title ? Astro.props.title + " | Photo" : "Photography";
if (Astro.props.imageName) {
  title = Astro.props.imageName + " | " + title;
}

const description =
  Astro.props.description || "My portfolio of artistic photographs.";
const gutter = "12px";

// console.log(JSON.stringify(galleryImages, null, 2))
---

<HeaderAndFooter
  allowMainStyles
  mainClass={initialMode}
  color="#eeeeeed0"
  colorOpaque="rgb(241, 241, 241)"
  themeColor="#f0f0f0"
  darkText
  hoverZoneBehind
  noBackdropFilter
  flangeColor="white"
  title={title}
  description={description}
  image={Astro.props.image}
>
  <div class="gallery-wrapper" id="galleryWrapper">
    {heading && <h1>{heading}</h1>}
    {subheading && <p class="gallery-subheading" set:html={subheading} />}

    <div
      id="photoContent"
      class={`${allowMap ? "" : "noMap"} ${allowFullscreen ? "" : "noFullscreen"}`}
    >
      <div id="gallery">
        {
          galleryImages.map((image) => {
            return (
              <div
                class="galleryImage"
                data-name={image.name}
                data-camera={image.metadata.camera}
                data-lens={image.metadata.lens}
                data-focal={image.metadata.focalLength}
                data-aperture={image.metadata.aperture}
                data-shutter={image.metadata.shutterSpeed}
                data-iso={image.metadata.iso}
                data-width={image.width}
                data-height={image.height}
                style={{
                  flexGrow: image.flexGrow,
                  aspectRatio: image.aspectRatio,
                  flexBasis: `calc(220px * (${image.flexGrow}))`,
                }}
              >
                <div class="astro-native-img-wrapper">
                  {/* Thumbnail */}
                  <Image
                    src={image.path}
                    alt={image.name || "Portfolio photograph"}
                    width={800}
                    quality={75}
                    format="webp"
                    loading="lazy"
                    class="thumb-img"
                  />

                  {/* High-Res Viewport Asset Node */}
                  <Image
                    src={image.path}
                    alt={image.name || "Portfolio photograph fullscreen"}
                    width={2000}
                    quality={85}
                    format="webp"
                    class="fullres-img"
                  />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    {
      allowFullscreen && (
        <div id="fullscreenOverlay" role="dialog" aria-modal="true">
          <img
            id="fullscreenPlaceholder"
            class="fullscreen-placeholder"
            alt=""
          />

          <div class="metadata-panel" id="metadataPanel">
            <div class="metadata-title" id="metaTitle" />
            <div class="metadata-chips-row" id="metaChipsRow" />
          </div>
        </div>
      )
    }
  </div>
</HeaderAndFooter>

<style define:vars={{ gutter }}>
  .gallery-wrapper {
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    box-sizing: border-box;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.5rem;
    color: #111;
  }

  .gallery-subheading {
    font-size: 1.1rem;
    max-width: 800px;
    margin: 0 auto 2.5rem auto;
    text-align: center;
    line-height: 1.6;
    color: #555;
  }

  #photoContent {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    position: relative;
  }

  #gallery {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gutter);
    width: 100%;
  }

  .galleryImage:hover {
    transform: translateY(-2px);
  }

  .astro-native-img-wrapper {
    width: 100%;
    height: 100%;
    display: block;
    position: relative;
    background-color: #f1f1f1;
    overflow: hidden;
  }

  .astro-native-img-wrapper img.thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
    will-change: transform;
    z-index: 1;
  }

  .astro-native-img-wrapper img.fullres-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
    pointer-events: none;
    z-index: 2;
  }

  .noFullscreen .astro-native-img-wrapper img.thumb-img {
    cursor: default;
  }

  #fullscreenOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    background-color: #ffffff;
    z-index: 99990;
    pointer-events: none;
    display: flex;
    opacity: 0;
    padding: 20px;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    gap: 20px;
    transition: opacity 0.3s ease-in-out;
  }

  #fullscreenOverlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  #fullscreenOverlay.layout-row {
    flex-direction: row;
  }

  #fullscreenOverlay.layout-column {
    flex-direction: column;
    gap: 20px;
  }

  #fullscreenOverlay.layout-row #fullscreenPlaceholder {
    max-width: calc(100% - 340px);
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  #fullscreenOverlay.layout-column #fullscreenPlaceholder {
    max-width: 100%;
    max-height: calc(100% - 120px);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .metadata-panel {
    position: relative;
    box-sizing: border-box;
    z-index: 999994;
    flex-shrink: 0;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: none;
    width: fit-content;
    max-width: 300px;
    text-align: center;
    gap: 0.5em;
  }

  .metadata-title {
    font-size: 1.3rem;
    font-weight: 500;
    width: 100%;
    word-wrap: break-word;
  }

  .metadata-chips-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem;
    width: 0;
    min-width: 100%;
  }

  :global(.meta-chip) {
    font-size: 0.82rem;
    padding: 0.3em 0.6em;
    background-color: #eee;
    border-radius: 1.1em;
    transition: all 0.2s ease;
  }

  @media screen and (max-width: 800px) {
    #gallery {
      flex-direction: column;
    }
    .galleryImage {
      width: 100%;
      flex-basis: auto !important;
      flex-grow: 1 !important;
    }
    h1 {
      font-size: 2rem;
    }
    #fullscreenOverlay {
      padding: 16px;
      gap: 16px;
    }
    #fullscreenOverlay.layout-row #fullscreenPlaceholder {
      max-width: calc(100% - 256px);
    }
    #fullscreenOverlay.layout-column #fullscreenPlaceholder {
      max-height: calc(100% - 96px);
    }
    #fullscreenOverlay.layout-row .metadata-panel {
      width: 240px;
    }
    #fullscreenOverlay.layout-column .metadata-panel {
      height: 80px;
    }
    .metadata-title {
      font-size: 1.1rem;
      margin-bottom: 0.35rem;
    }
    :global(.meta-chip) {
      font-size: 0.75rem;
      padding: 0.25rem 0.55rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const fullScreenEl = document.querySelector("#fullscreenOverlay");
    const metadataTitle = document.querySelector("#metaTitle");
    const fullScreenImage = document.querySelector("#fullscreenPlaceholder");
    const metaChipsRow = document.querySelector("#metaChipsRow") as HTMLElement;

    const galleryImages = document.querySelectorAll(".galleryImage");
    galleryImages.forEach((image) => {
      image.addEventListener("click", () => {
        console.log("Image clicked");
        enterFullscreen(image as HTMLImageElement);
      });
    });

    // Close overlay on background click
    fullScreenEl?.addEventListener("click", (e) => {
      if (!(e.target as HTMLElement).closest("#metadataPanel")) {
        exitFullscreen();
      }
    });

    function enterFullscreen(image: HTMLImageElement) {
      const dataName = image.getAttribute("data-name");
      const dataCamera = image.getAttribute("data-camera");
      const dataLens = image.getAttribute("data-lens");
      const dataShutter = image.getAttribute("data-shutter");
      const dataAperture = image.getAttribute("data-aperture");
      const dataIso = image.getAttribute("data-iso");
      const dataFocal = image.getAttribute("data-focal");
      console.log(
        dataName,
        dataCamera,
        dataLens,
        dataShutter,
        dataAperture,
        dataIso,
        dataFocal,
      );

      if (metadataTitle) {
        metadataTitle.textContent = dataName || "";
      }

      if (metaChipsRow) {
        if (
          !dataCamera &&
          !dataLens &&
          !dataAperture &&
          !dataShutter &&
          !dataIso &&
          !dataFocal
        ) {
          metaChipsRow.style.display = "none";
        } else {
          metaChipsRow.style.display = "flex";

          metaChipsRow.innerHTML = "";
          const specs = [
            { value: dataCamera, label: "" },
            { value: dataLens, label: "" },
            { value: dataFocal, label: "" },
            { value: dataShutter, label: "s" },
            { value: dataAperture, prefix: "f/" },
            { value: dataIso, prefix: "ISO " },
          ];

          specs.forEach((spec) => {
            if (
              spec.value &&
              spec.value !== "undefined" &&
              spec.value !== "null"
            ) {
              const chip = document.createElement("span");
              chip.className = "meta-chip";
              let text = spec.value;
              if (spec.prefix) text = spec.prefix + text;
              if (spec.label && !text.endsWith(spec.label))
                text = text + spec.label;
              chip.textContent = text;
              metaChipsRow.appendChild(chip);
            }
          });
        }
      }

      if (fullScreenImage) {
        // Try multiple selectors to find the 2000px high-res image
        const fullResEl =
          image.querySelector(".fullres-img") ||
          image.querySelector("img[alt*='fullscreen']") ||
          image.querySelector("img:last-of-type");

        const thumbEl =
          image.querySelector(".thumb-img") || image.querySelector("img");

        // Prefer fullres src (absolute or relative)
        const src =
          fullResEl?.getAttribute("src") ||
          (fullResEl as HTMLImageElement)?.src ||
          thumbEl?.getAttribute("src") ||
          (thumbEl as HTMLImageElement)?.src;

        console.log("Full Screen Image element:", fullScreenImage);
        console.log("Found High-Res Image Element:", fullResEl);
        console.log("Resolved Image source URL:", src);

        fullScreenImage.setAttribute("src", src || "");
        fullScreenImage.setAttribute(
          "data-width",
          image.getAttribute("data-width") || "",
        );
        fullScreenImage.setAttribute(
          "data-height",
          image.getAttribute("data-height") || "",
        );
      }
      updateFullscreenOrientation();
      fullScreenEl?.classList.add("active");
    }

    function exitFullscreen() {
      fullScreenEl?.classList.remove("active");
    }

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        exitFullscreen();
      }
    });

    window.addEventListener("resize", () => {
      updateFullscreenOrientation();
    });

    function fullScreenOrrientationHorizontal(
      width: number,
      height: number,
    ): boolean {
      const isMobile = window.innerWidth <= 800;
      const currentMetaMinWidth = isMobile ? 240 : 300;
      const currentMetaMinHeight = isMobile ? 80 : 100;
      const currentGutter = isMobile ? 16 : 20;

      let W = window.innerWidth - currentGutter * 2;
      let H = window.innerHeight - currentGutter * 2;

      // assume horizontal
      let w = W - currentMetaMinWidth;
      const scaleH = Math.min(w / width, H / height);

      // assume vertical
      let h = H - currentMetaMinHeight;
      const scaleV = Math.min(h / height, W / width);

      return scaleH > scaleV;
    }

    function updateFullscreenOrientation() {
      if (fullScreenImage && fullScreenEl) {
        const width = fullScreenImage.getAttribute("data-width");
        const height = fullScreenImage.getAttribute("data-height");
        const isHorizontal = fullScreenOrrientationHorizontal(
          parseInt(width || "0"),
          parseInt(height || "0"),
        );
        fullScreenEl.classList.toggle("layout-row", isHorizontal);
        fullScreenEl.classList.toggle("layout-column", !isHorizontal);
      }
    }
  });
</script>
