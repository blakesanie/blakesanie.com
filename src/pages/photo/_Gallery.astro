      }, 250);
    } else {
      // --- STANDARD SHARED ELEMENT ANIMATION FOR GALLERY VIEW ---
      const galleryRect = thumbImg.getBoundingClientRect();
      const destRect = fullScreenImage
        ? fullScreenImage.getBoundingClientRect()
