---
import HeaderAndFooter from "../../components/HeaderAndFooter/index.astro";
import { Image, getImage } from "astro:assets";
import MapGallery from "./_MapGallery.astro";
import { encodeEmbeddings } from "./_utils";
import Toggle from "../../components/Toggle/index.astro";
import TextInput from "../../components/TextInput/index.astro";

export interface Props {
  imagesData: any[];
  embeddingsJson?: Record<string, any>;
  image?: string;
  imageName?: string;
  initialMode?: string;
  allowFullscreen?: boolean;
  allowMap?: boolean;
  randomize?: boolean;
  heading?: string;
  subheading?: string;
  allowDownload?: boolean;
  allowFilename?: boolean;
  allowBlog?: boolean;
  allowUniqueUrls?: boolean;
  title?: string;
  description?: string;
}

const {
  imagesData = [],
  heading = "Photography",
  subheading,
  initialMode = "gallery",
  allowMap = false,
  allowFullscreen = false,
} = Astro.props;

const lensReplacements: Record<string, string> = {
  "AF-S DX VR Zoom-Nikkor 18-105mm f/3.5-5.6G ED":
    "Nikon 18-105mm f/3.5-5.6G DX",
  "Tamron 20-40mm F2.8 Di III VXD": "Tamron 20-40mm F2.8",
  "FE 28-70mm F3.5-5.6 OSS": "Sony 28-70mm F3.5-5.6",
  "AF-S DX Nikkor 35mm f/1.8G": "Nikon 35mm f/1.8G DX",
  "SAMYANG AF 24mm F2.8": "Rokinon 24mm F2.8",
  "Tamron 70-300mm F4.5-6.3 Di III RXD": "Tamron 70-300mm F4.5-6.3",
  "----": "Helios 44/2",
};

const cameraReplacements: Record<string, string> = {
  "ILCE-7C": "Sony a7C",
  "NIKON D3200": "Nikon D3200",
  "ILCE-7": "Sony a7",
  FC3682: "DJI Mini 3",
};

function resolveCamera(exif: Record<string, string>) {
  for (const x of ["model", "Camera Model Name", "Model"]) {
    if (exif[x] && cameraReplacements[exif[x]])
      return cameraReplacements[exif[x]];
  }
}

function resolveLens(exif: Record<string, string>) {
  for (const x of ["Lens ID", "Lens Model", "Lens Spec"]) {
    if (exif[x] && lensReplacements[exif[x]]) return lensReplacements[exif[x]];
  }
}

function resolveShutter(exif: Record<string, string>) {
  let x = exif["Exposure Time"];
  if (x) return x;
}

function resolveAperture(exif: Record<string, string>) {
  const x = exif["F Number"];
  if (x) {
    const n = parseFloat(x);
    if (Math.round(n) === n) {
      return Math.round(n);
    }
    return x;
  }
}

function dmsToDecimal(dmsStr: string) {
  if (!dmsStr) return null;
  const regex = /(\d+)\s*deg\s*(\d+)'\s*([\d.]+)"\s*([NSEW])/i;
  const match = dmsStr.match(regex);
  if (!match) return null;

  const degrees = parseInt(match[1], 10);
  const minutes = parseInt(match[2], 10);
  const seconds = parseFloat(match[3]);
  const direction = match[4].toUpperCase();

  let decimal = degrees + minutes / 60 + seconds / 3600;
  if (direction === "S" || direction === "W") decimal = -decimal;
  return parseFloat(decimal.toFixed(6));
}

// Process the image items mapping dimensions and metadata dynamically
const galleryImages = await Promise.all(
  imagesData.map(async (img) => {
    const { name, path: imageAsset, width, height, exif, embeddings } = img;

    const aspectRatioNum = width && height ? width / height : 1;

    // Pre-calculate optimized high-res URL for deferred loading
    const highRes = await getImage({
      src: imageAsset,
      width: Math.round(Math.sqrt(2500000 / (height * width)) * width),
      quality: 85,
      format: "webp",
    });

    return {
      name,
      path: imageAsset,
      fullResSrc: highRes.src,
      flexGrow: aspectRatioNum,
      aspectRatio: width && height ? `${width} / ${height}` : "auto",
      width,
      height,
      embeddings,
      metadata: {
        camera: resolveCamera(exif),
        lens: resolveLens(exif),
        focalLength: exif["Focal Length In 35mm Format"],
        aperture: resolveAperture(exif),
        shutterSpeed: resolveShutter(exif),
        iso: exif.ISO,
        lon: dmsToDecimal(exif["GPS Longitude"]),
        lat: dmsToDecimal(exif["GPS Latitude"]),
      },
    };
  }),
);

const mapImages = await Promise.all(
  galleryImages
    .filter((img) => img.metadata.lat !== null && img.metadata.lon !== null)
    .map(async (img) => {
      const originalAR = img.width / img.height;
      const targetArea = 4000;
      const h = Math.sqrt(targetArea / originalAR);
      const w = targetArea / h;

      const optimized = await getImage({
        src: img.path,
        width: Math.round(w),
        height: Math.round(h),
        format: "webp",
      });
      return {
        name: img.name,
        path: optimized.src,
        lat: img.metadata.lat,
        lon: img.metadata.lon,
        width: Math.round(w),
        height: Math.round(h),
      };
    }),
);

let title = Astro.props.title ? Astro.props.title + " | Photo" : "Photography";
if (Astro.props.imageName) {
  title = Astro.props.imageName + " | " + title;
}

const description =
  Astro.props.description || "My portfolio of artistic photographs.";
const gutter = "10px";
---

<HeaderAndFooter
  allowMainStyles
  mainClass={initialMode}
  color="#eeeeeed0"
  colorOpaque="rgb(241, 241, 241)"
  themeColor="#f0f0f0"
  darkText
  hoverZoneBehind
  noBackdropFilter
  flangeColor="white"
  title={title}
  description={description}
  image={Astro.props.image}
>
  {heading && <h1>{heading}</h1>}
  {subheading && <p set:html={subheading} />}
  <div id="controls">
    {
      allowMap && (
        <Toggle
          actions={[
            { id: "toggleGallery", label: "Gallery" },
            { id: "toggleMap", label: "Map" },
          ]}
          defaultAction={initialMode == "map" ? "toggleMap" : "toggleGallery"}
        />
      )
    }
    <TextInput
      id="clip"
      label="AI Image Search"
      placeholder="Loading Model..."
      disabled
    />
  </div>

  <div
    id="photoContent"
    class={`${allowMap ? "" : "noMap"} ${allowFullscreen ? "" : "noFullscreen"} view-${initialMode}`}
  >
    <div id="gallery">
      {
        galleryImages.map((image) => {
          return (
            <div
              class="galleryImage"
              data-name={image.name}
              data-fullres={image.fullResSrc}
              data-camera={image.metadata.camera}
              data-lens={image.metadata.lens}
              data-focal={image.metadata.focalLength}
              data-aperture={image.metadata.aperture}
              data-shutter={image.metadata.shutterSpeed}
              data-iso={image.metadata.iso}
              data-width={image.width}
              data-height={image.height}
              data-lat={image.metadata.lat}
              data-lon={image.metadata.lon}
              data-emb={encodeEmbeddings(image.embeddings)}
              style={{
                flexGrow: image.flexGrow,
                aspectRatio: image.aspectRatio,
                flexBasis: `calc(var(--base-height) * (${image.flexGrow}))`,
                maxHeight: `calc(500px)`,
                maxWidth: `calc(500px * ${image.flexGrow})`,
              }}
            >
              <div class="astro-native-img-wrapper">
                {/* Thumbnail */}
                <Image
                  src={image.path}
                  alt={image.name || "Portfolio photograph"}
                  width={Math.max(
                    600,
                    Math.round((500 / image.height) * image.width),
                  )}
                  quality={75}
                  format="webp"
                  loading="lazy"
                  class="thumb-img"
                />
              </div>
            </div>
          );
        })
      }
    </div>

    {allowMap && <MapGallery mapImages={mapImages} />}
  </div>

  {
    allowFullscreen && (
      <div id="fullscreenOverlay" role="dialog" aria-modal="true" tabindex="-1">
        <div id="fullscreenScroll">
          <div id="imageViewport">
            <div class="metadata-panel" id="metadataPanel">
              <div class="metadata-title" id="metaTitle" />
              <div class="metadata-chips-row" id="metaChipsRow" />
              <div class="metadata-actions">
                <div id="exitButton">Exit</div>
                <div id="prevButton">Prev</div>
                <div id="nextButton">Next</div>
              </div>
            </div>
            <img
              id="fullscreenPlaceholder"
              class="fullscreen-placeholder"
              alt=""
            />
          </div>
          <div id="viewportBelow">
            <div id="selectedMap" />
          </div>
        </div>
      </div>
    )
  }
</HeaderAndFooter>

<style define:vars={{ gutter }}>
  #controls {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }

  :global(.textInput) {
    max-width: 420px;
  }

  #photoContent {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 100% !important;
    position: relative;
    margin-top: 30px;
  }

  #gallery {
    display: none;
    flex-wrap: wrap;
    gap: var(--gutter);
    width: 100%;
    --base-height: 280px;
    justify-content: center;
  }

  #photoContent.view-gallery #gallery {
    display: flex;
  }

  @media screen and (max-width: 1050px) {
    #gallery {
      --base-height: 220px;
    }
  }

  .galleryImage:hover {
    transform: translateY(-2px);
  }

  .astro-native-img-wrapper {
    width: 100%;
    height: 100%;
    display: block;
    position: relative;
    background-color: #f1f1f1;
    overflow: hidden;
  }

  .astro-native-img-wrapper img.thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
    will-change: transform;
    z-index: 1;
  }

  .noFullscreen .astro-native-img-wrapper img.thumb-img {
    cursor: default;
  }

  #fullscreenOverlay {
    position: fixed;
    top: 0;
    left: 0;
    min-width: 100vw;
    min-height: 100dvh;
    max-height: 100dvh;
    background-color: #ffffff;
    z-index: 99990;
    pointer-events: none;
    transition: opacity 0.4s ease-in-out;
    opacity: 0;
    display: none;
    flex-direction: column;
  }

  #fullscreenOverlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  #fullscreenScroll {
    flex: 1;
    overflow-y: scroll;
    display: flex;
    flex-direction: column;
  }

  #imageViewport {
    min-width: 100vw;
    min-height: 100dvh;
    display: flex;
    padding: 20px;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    gap: 20px;
  }

  #viewportBelow {
    min-width: 100vw;
    max-width: 100vw;
    min-height: 100dvh;
    max-height: 100dvh;
    padding: 20px;
    box-sizing: border-box;
    display: none;
  }

  #selectedMap {
    flex: 1;
  }

  #imageViewport.layout-row {
    flex-direction: row;
  }

  #imageViewport.layout-column {
    flex-direction: column;
  }

  .fullscreen-placeholder {
    position: relative;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    z-index: 2;
    background-color: #f1f1f1;
    opacity: 0;
  }

  .fullscreen-placeholder.loaded {
    opacity: 1;
  }

  :global(.gallery-transition-clone) {
    position: fixed;
    pointer-events: none;
    z-index: 999995;
    will-change: transform, top, left, width, height, opacity;
    transition:
      top 0.4s cubic-bezier(0.25, 1, 0.5, 1),
      left 0.4s cubic-bezier(0.25, 1, 0.5, 1),
      width 0.4s cubic-bezier(0.25, 1, 0.5, 1),
      height 0.4s cubic-bezier(0.25, 1, 0.5, 1),
      opacity 0.3s ease;
    object-fit: cover;
  }

  .metadata-panel {
    position: relative;
    box-sizing: border-box;
    z-index: 999994;
    flex-shrink: 0;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: none;
    width: fit-content;
    max-width: 100%;
    text-align: center;
    gap: 0.5em;
  }

  .layout-row .metadata-panel {
    max-width: 300px;
  }

  .layout-column .metadata-panel {
    max-width: none;
  }

  .metadata-title {
    font-size: 1.3rem;
    font-weight: 500;
    width: 100%;
    word-wrap: break-word;
  }

  .metadata-chips-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem;
    width: 100%;
  }

  #fullscreenOverlay.layout-row .metadata-chips-row {
    width: 0;
    min-width: 100%;
  }

  :global(.meta-chip) {
    font-size: 0.82rem;
    padding: 0.3em 0.6em;
    background-color: #eee;
    border-radius: 1.1em;
    transition: all 0.1s ease;
  }

  .metadata-actions {
    display: flex;
    flex-direction: row;
  }

  .metadata-actions div {
    width: 3em;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.1s ease;
  }

  .metadata-actions div:hover {
    opacity: 1;
  }

  @media screen and (max-width: 800px) {
    #gallery {
      --base-height: 190px;
    }
    #imageViewport {
      padding: 12px;
      gap: 12px;
    }
    :global(.pageContent) {
      padding-left: 12px !important;
      padding-right: 12px !important;
    }
    .gallery-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .view-toggle {
      position: static;
      margin-bottom: 1rem;
    }
  }

  @media screen and (max-width: 480px) {
    #gallery {
      flex-direction: column;
    }
    .galleryImage {
      width: 100%;
      flex-basis: auto !important;
      flex-grow: 1 !important;
    }
  }
</style>

<script>
  import { cleanseName, dotProduct } from "./_utils";

  const fullScreenEl = document.querySelector("#fullscreenOverlay");
  const fullScreenScroll = document.querySelector("#fullscreenScroll");
  const metadataTitle = document.querySelector("#metaTitle");
  const fullScreenImage = document.querySelector("#fullscreenPlaceholder");
  const imageViewport = document.querySelector("#imageViewport") as HTMLElement;
  const metaChipsRow = document.querySelector("#metaChipsRow") as HTMLElement;

  const viewportBelow = document.querySelector("#viewportBelow") as HTMLElement;
  const selectedMapEl = document.querySelector("#selectedMap") as HTMLElement;

  const exitButton = document.querySelector("#exitButton") as HTMLElement;
  const nextButton = document.querySelector("#nextButton") as HTMLElement;
  const prevButton = document.querySelector("#prevButton") as HTMLElement;

  const galleryImages = document.querySelectorAll(".galleryImage");
  const photoContent = document.getElementById("photoContent");

  let activeTransitionImg: HTMLImageElement | null = null;
  let isEnterAnimating = false;
  let isExitAnimating = false;

  const initialTitle = document.title;
  let baseTitle = initialTitle;
  const currentPath = window.location.pathname;

  if (
    currentPath.startsWith("/photo/") &&
    currentPath !== "/photo/" &&
    currentPath !== "/photo/map" &&
    !currentPath.startsWith("/photo/albums/")
  ) {
    const parts = initialTitle.split(" | ");
    if (parts.length >= 3) {
      baseTitle = parts.slice(1).join(" | ");
    }
  }

  function buildSelectedMap(lon: number, lat: number) {
    // @ts-ignore
    const selectedMap = new google.maps.Map(selectedMapEl, {
      center: { lat: lat, lng: lon },
      zoom: 16,
      zoomControl: true,
      zoomControlOptions: {
        // @ts-ignore
        position: google.maps.ControlPosition.RIGHT_CENTER,
      },
      streetViewControl: true,
      streetViewControlOptions: {
        // @ts-ignore
        position: google.maps.ControlPosition.RIGHT_CENTER,
      },
      fullscreenControl: false,
      rotateControl: true,
      rotateControlOptions: {
        // @ts-ignore
        position: google.maps.ControlPosition.RIGHT_CENTER,
      },
      styles: [
        { elementType: "geometry", stylers: [{ color: "#ffffff" }] },
        { elementType: "labels.icon", stylers: [{ visibility: "off" }] },
        { elementType: "labels.text.fill", stylers: [{ color: "#616161" }] },
        { elementType: "labels.text.stroke", stylers: [{ color: "#f5f5f5" }] },
        {
          featureType: "administrative.land_parcel",
          elementType: "labels.text.fill",
          stylers: [{ color: "#bdbdbd" }],
        },
        {
          featureType: "administrative.province",
          elementType: "geometry.stroke",
          stylers: [{ color: "#9e9e9e" }],
        },
        {
          featureType: "landscape.natural.terrain",
          stylers: [{ color: "#c9c9c9" }],
        },
        {
          featureType: "poi",
          elementType: "geometry",
          stylers: [{ color: "#f5f5f5" }],
        },
        {
          featureType: "poi",
          elementType: "labels.text.fill",
          stylers: [{ color: "#757575" }],
        },
        {
          featureType: "poi.park",
          elementType: "geometry",
          stylers: [{ color: "#ededed" }],
        },
        {
          featureType: "poi.park",
          elementType: "labels.text.fill",
          stylers: [{ color: "#b0b0b0" }],
        },
        {
          featureType: "road",
          elementType: "geometry",
          stylers: [{ visibility: "simplified" }],
        },
        {
          featureType: "road",
          elementType: "geometry.stroke",
          stylers: [{ color: "#f2f2f2" }, { visibility: "on" }],
        },
        {
          featureType: "road.arterial",
          elementType: "labels.text.fill",
          stylers: [{ color: "#757575" }],
        },
        {
          featureType: "road.highway",
          elementType: "geometry",
          stylers: [{ color: "#e6e6e6" }],
        },
        {
          featureType: "road.highway",
          elementType: "geometry.stroke",
          stylers: [{ visibility: "simplified" }],
        },
        {
          featureType: "road.highway",
          elementType: "labels.text.fill",
          stylers: [{ color: "#616161" }],
        },
        {
          featureType: "road.local",
          elementType: "labels.text.fill",
          stylers: [{ color: "#9e9e9e" }],
        },
        {
          featureType: "transit.line",
          elementType: "geometry",
          stylers: [{ color: "#e5e5e5" }],
        },
        {
          featureType: "transit.station",
          elementType: "geometry",
          stylers: [{ color: "#eeeeee" }],
        },
        {
          featureType: "water",
          elementType: "geometry",
          stylers: [{ color: "#c9c9c9" }],
        },
        {
          featureType: "water",
          elementType: "geometry.fill",
          stylers: [{ color: "#c7e9ff" }],
        },
        {
          featureType: "water",
          elementType: "labels.text.fill",
          stylers: [{ color: "#9e9e9e" }],
        },
      ],
    });
    // @ts-ignore
    new google.maps.Marker({
      position: { lat: lat, lng: lon },
      map: selectedMap,
    });
  }

  function fullScreenOrrientationHorizontal(
    width: number,
    height: number,
  ): boolean {
    const isMobile = window.innerWidth <= 800;
    const currentMetaMinWidth = isMobile ? 240 : 300;
    const currentMetaMinHeight = isMobile ? 80 : 100;
    const currentGutter = isMobile ? 16 : 20;

    let W = window.innerWidth - currentGutter * 2;
    let H = window.innerHeight - currentGutter * 2;

    let w = W - currentMetaMinWidth;
    const scaleH = Math.min(w / width, H / height);

    let h = H - currentMetaMinHeight;
    const scaleV = Math.min(h / height, W / width);

    return scaleH > scaleV;
  }

  function updateFullscreenOrientation() {
    if (fullScreenImage && fullScreenEl) {
      const width = fullScreenImage.getAttribute("data-width");
      const height = fullScreenImage.getAttribute("data-height");
      const isHorizontal = fullScreenOrrientationHorizontal(
        parseInt(width || "0"),
        parseInt(height || "0"),
      );
      imageViewport?.classList.toggle("layout-row", isHorizontal);
      imageViewport?.classList.toggle("layout-column", !isHorizontal);

      const imgWidth = parseInt(width || "0");
      const imgHeight = parseInt(height || "0");
      if (imgWidth > 0 && imgHeight > 0) {
        const isMobile = window.innerWidth <= 800;
        const currentGutter = isMobile ? 16 : 20;
        const currentGap = isMobile ? 16 : 20;
        const metadataPanel = document.querySelector(
          "#metadataPanel",
        ) as HTMLElement;

        let targetWidth = 0;
        let targetHeight = 0;

        if (isHorizontal) {
          const metadataWidth = metadataPanel ? metadataPanel.offsetWidth : 300;
          const wAvail =
            window.innerWidth - metadataWidth - currentGutter * 2 - currentGap;
          const hAvail = window.innerHeight - currentGutter * 2;
          const scale = Math.min(wAvail / imgWidth, hAvail / imgHeight);
          targetWidth = imgWidth * scale;
          targetHeight = imgHeight * scale;
        } else {
          const metadataHeight = metadataPanel
            ? metadataPanel.offsetHeight
            : 100;
          const wAvail = window.innerWidth - currentGutter * 2;
          const hAvail =
            window.innerHeight -
            metadataHeight -
            currentGutter * 2 -
            currentGap;
          const scale = Math.min(wAvail / imgWidth, hAvail / imgHeight);
          targetWidth = imgWidth * scale;
          targetHeight = imgHeight * scale;
        }

        (fullScreenImage as HTMLElement).style.width = `${targetWidth}px`;
        (fullScreenImage as HTMLElement).style.height = `${targetHeight}px`;
      }
    }
  }

  function enterFullscreen(image: HTMLImageElement, pushState = true) {
    if (!fullScreenEl) return;
    if (isEnterAnimating || isExitAnimating) return;

    // Remove any previous active transitions if they somehow exist
    if (activeTransitionImg && activeTransitionImg.parentNode) {
      activeTransitionImg.parentNode.removeChild(activeTransitionImg);
      activeTransitionImg = null;
    }

    document.querySelector(".galleryImage.active")?.classList.remove("active");

    let targetImage = image;
    if (!image.classList.contains("galleryImage")) {
      const name = image.getAttribute("data-name");
      const found = Array.from(galleryImages).find(
        (el) => el.getAttribute("data-name") === name,
      );
      if (found) targetImage = found as HTMLImageElement;
    }

    targetImage.classList.add("active");

    const dataName = targetImage.getAttribute("data-name");
    const dataCamera = targetImage.getAttribute("data-camera");
    const dataLens = targetImage.getAttribute("data-lens");
    const dataShutter = targetImage.getAttribute("data-shutter");
    const dataAperture = targetImage.getAttribute("data-aperture");
    const dataIso = targetImage.getAttribute("data-iso");
    const dataFocal = targetImage.getAttribute("data-focal");
    const dataLon = targetImage.getAttribute("data-lon");
    const dataLat = targetImage.getAttribute("data-lat");

    if (dataName) {
      document.title = `${dataName} | Photography | Blake Sanie`;
    }

    if (pushState && dataName) {
      const path = window.location.pathname;
      const isPhotoPage =
        path === "/photo" ||
        path === "/photo/map" ||
        (path.startsWith("/photo/") && !path.startsWith("/photo/albums/"));
      if (isPhotoPage) {
        const cleansed = cleanseName(dataName);
        const newPath = `/photo/${cleansed}`;
        if (window.location.pathname !== newPath) {
          window.history.pushState(
            {
              view: photoContent?.classList.contains("view-map")
                ? "map"
                : "gallery",
              photo: dataName,
            },
            "",
            newPath,
          );
        }
      }
    }

    if (dataLon && dataLat && viewportBelow) {
      viewportBelow.style.display = "flex";
      buildSelectedMap(parseFloat(dataLon), parseFloat(dataLat));
    } else if (viewportBelow) {
      viewportBelow.style.display = "none";
    }

    if (metadataTitle) {
      metadataTitle.textContent = dataName || "";
    }

    if (metaChipsRow) {
      if (
        !dataCamera &&
        !dataLens &&
        !dataAperture &&
        !dataShutter &&
        !dataIso &&
        !dataFocal
      ) {
        metaChipsRow.style.display = "none";
      } else {
        metaChipsRow.style.display = "flex";
        metaChipsRow.innerHTML = "";
        const specs = [
          { value: dataCamera, label: "" },
          { value: dataLens, label: "" },
          { value: dataFocal, label: "" },
          { value: dataShutter, label: "s" },
          { value: dataAperture, prefix: "f/" },
          { value: dataIso, prefix: "ISO " },
        ];
        specs.forEach((spec) => {
          if (
            spec.value &&
            spec.value !== "undefined" &&
            spec.value !== "null"
          ) {
            const chip = document.createElement("span");
            chip.className = "meta-chip";
            let text = spec.value;
            if (spec.prefix) text = spec.prefix + text;
            if (spec.label && !text.endsWith(spec.label))
              text = text + spec.label;
            chip.textContent = text;
            metaChipsRow.appendChild(chip);
          }
        });
      }
    }

    const isAlreadyFullscreen = fullScreenEl.classList.contains("active");

    if (isAlreadyFullscreen) {
      // If we are already in fullscreen (e.g. Next/Prev navigation), update without enter transition animation
      if (fullScreenImage) {
        const fullResSrc = targetImage.getAttribute("data-fullres");
        fullScreenImage.setAttribute("src", "");
        (fullScreenImage as HTMLElement).classList.remove("loaded");
        fullScreenImage.setAttribute(
          "data-width",
          targetImage.getAttribute("data-width") || "",
        );
        fullScreenImage.setAttribute(
          "data-height",
          targetImage.getAttribute("data-height") || "",
        );
        (fullScreenImage as HTMLImageElement).onload = () => {
          (fullScreenImage as HTMLElement).classList.add("loaded");
        };
        fullScreenImage.setAttribute("src", fullResSrc || "");
      }
      updateFullscreenOrientation();
      requestAnimationFrame(() => {
        updateFullscreenOrientation();
      });
      if (fullScreenScroll) {
        fullScreenScroll.scrollTop = 0;
      }
      return;
    }

    // Scroll to top of fullscreen view first
    if (fullScreenScroll) {
      fullScreenScroll.scrollTop = 0;
    }

    // Entering fullscreen with animations
    isEnterAnimating = true;

    // Lock page scroll
    document.body.style.overflow = "hidden";

    // Get thumbnail image
    const thumbImg = targetImage.querySelector("img.thumb-img") as HTMLImageElement;
    const galleryRect = thumbImg.getBoundingClientRect();

    // Show the overlay layout container
    (fullScreenEl as HTMLElement).style.display = "flex";
    (fullScreenEl as HTMLElement).offsetHeight; // force reflow

    // Setup fullscreen image dimensions (invisible for now)
    const fullResSrc = targetImage.getAttribute("data-fullres");
    if (fullScreenImage) {
      fullScreenImage.setAttribute("src", "");
      (fullScreenImage as HTMLElement).classList.remove("loaded");
      fullScreenImage.setAttribute(
        "data-width",
        targetImage.getAttribute("data-width") || "",
      );
      fullScreenImage.setAttribute(
        "data-height",
        targetImage.getAttribute("data-height") || "",
      );
    }

    // Calculate layout coordinates for target fullscreen image using aspect ratio
    updateFullscreenOrientation();

    // Force layout update on fullScreenImage so destRect has correct coordinates
    if (fullScreenImage) {
      (fullScreenImage as HTMLElement).offsetHeight;
    }

    // Get coordinates of layouted invisible full screen image
    const destRect = fullScreenImage ? fullScreenImage.getBoundingClientRect() : galleryRect;

    console.log("enterFullscreen: galleryRect =", {
      left: galleryRect.left,
      top: galleryRect.top,
      width: galleryRect.width,
      height: galleryRect.height,
    });
    console.log("enterFullscreen: destRect =", {
      left: destRect.left,
      top: destRect.top,
      width: destRect.width,
      height: destRect.height,
    });

    // Create floating transition image clone
    const transitionImg = document.createElement("img");
    transitionImg.src = thumbImg.src;
    transitionImg.className = "gallery-transition-clone";
    
    // Set styles inline to bypass Astro component-scoped styles
    transitionImg.style.position = "fixed";
    transitionImg.style.pointerEvents = "none";
    transitionImg.style.zIndex = "999995";
    transitionImg.style.objectFit = "cover";
    transitionImg.style.willChange = "transform, top, left, width, height, opacity";
    transitionImg.style.transition = "top 0.4s cubic-bezier(0.25, 1, 0.5, 1), left 0.4s cubic-bezier(0.25, 1, 0.5, 1), width 0.4s cubic-bezier(0.25, 1, 0.5, 1), height 0.4s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease";
    
    transitionImg.style.left = `${galleryRect.left}px`;
    transitionImg.style.top = `${galleryRect.top}px`;
    transitionImg.style.width = `${galleryRect.width}px`;
    transitionImg.style.height = `${galleryRect.height}px`;

    // Hide original gallery image visually during animation
    thumbImg.style.opacity = "0";

    document.body.appendChild(transitionImg);
    activeTransitionImg = transitionImg;

    // Force reflow on the newly added clone so the browser registers its initial state!
    transitionImg.offsetHeight;

    // Animate the floating clone and fade in overlay background
    setTimeout(() => {
      fullScreenEl.classList.add("active");

      transitionImg.style.left = `${destRect.left}px`;
      transitionImg.style.top = `${destRect.top}px`;
      transitionImg.style.width = `${destRect.width}px`;
      transitionImg.style.height = `${destRect.height}px`;
    }, 20);

    let enlargeFinished = false;
    let highResLoaded = false;

    const checkCompleteAndCrossfade = () => {
      if (enlargeFinished && highResLoaded) {
        if (fullScreenImage) {
          (fullScreenImage as HTMLElement).classList.add("loaded");
        }
        
        // Immediately remove the clone from the DOM with no transition
        if (transitionImg.parentNode) {
          transitionImg.parentNode.removeChild(transitionImg);
        }
        if (activeTransitionImg === transitionImg) {
          activeTransitionImg = null;
        }
        thumbImg.style.opacity = "";
        isEnterAnimating = false;
      }
    };

    // Listen to enlarge animation end (400ms duration)
    setTimeout(() => {
      enlargeFinished = true;
      checkCompleteAndCrossfade();
    }, 400);

    // Load high-resolution image
    if (fullScreenImage) {
      (fullScreenImage as HTMLImageElement).onload = () => {
        highResLoaded = true;
        checkCompleteAndCrossfade();
      };
      fullScreenImage.setAttribute("src", fullResSrc || "");
    } else {
      highResLoaded = true;
      checkCompleteAndCrossfade();
    }

    (fullScreenEl as HTMLElement)?.focus();
    requestAnimationFrame(() => {
      updateFullscreenOrientation();
      (fullScreenEl as HTMLElement)?.focus();
    });
  }

  function exitFullscreen(pushState = true) {
    if (!fullScreenEl) return;
    if (isEnterAnimating || isExitAnimating) return;

    isExitAnimating = true;

    // Find the currently active gallery image element
    const activeGalleryImg = document.querySelector(".galleryImage.active") as HTMLElement;
    if (!activeGalleryImg) {
      // Fallback
      fullScreenEl.classList.remove("active");
      setTimeout(() => {
        fullScreenEl.style.display = "none";
      }, 400);
      document.body.style.overflow = "";
      isExitAnimating = false;
      return;
    }

    const thumbImg = activeGalleryImg.querySelector("img.thumb-img") as HTMLImageElement;

    // Check if original gallery image is on screen (fully visible)
    const rect = thumbImg.getBoundingClientRect();
    const isVisible = (
      rect.top >= 0 &&
      rect.bottom <= window.innerHeight &&
      rect.left >= 0 &&
      rect.right <= window.innerWidth
    );

    if (!isVisible) {
      // Calculate scroll positioning to center the image on the Y axis
      const absoluteTop = window.scrollY + rect.top;
      const elementHeight = rect.height;
      const targetScrollY = absoluteTop + (elementHeight / 2) - (window.innerHeight / 2);
      window.scrollTo({ top: targetScrollY, behavior: "auto" });
    }

    // Get final gallery image coordinates after scrolling
    const finalGalleryRect = thumbImg.getBoundingClientRect();

    // Get current fullscreen image dimensions
    const finalOverlayRect = fullScreenImage ? fullScreenImage.getBoundingClientRect() : finalGalleryRect;

    console.log("exitFullscreen: finalOverlayRect =", {
      left: finalOverlayRect.left,
      top: finalOverlayRect.top,
      width: finalOverlayRect.width,
      height: finalOverlayRect.height,
    });
    console.log("exitFullscreen: finalGalleryRect =", {
      left: finalGalleryRect.left,
      top: finalGalleryRect.top,
      width: finalGalleryRect.width,
      height: finalGalleryRect.height,
    });

    // Create transition clone at current fullscreen placeholder coordinates
    const transitionImg = document.createElement("img");
    transitionImg.src = thumbImg.src;
    transitionImg.className = "gallery-transition-clone";

    // Set styles inline to bypass Astro component-scoped styles
    transitionImg.style.position = "fixed";
    transitionImg.style.pointerEvents = "none";
    transitionImg.style.zIndex = "999995";
    transitionImg.style.objectFit = "cover";
    transitionImg.style.willChange = "transform, top, left, width, height, opacity";
    transitionImg.style.transition = "top 0.4s cubic-bezier(0.25, 1, 0.5, 1), left 0.4s cubic-bezier(0.25, 1, 0.5, 1), width 0.4s cubic-bezier(0.25, 1, 0.5, 1), height 0.4s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease";

    transitionImg.style.left = `${finalOverlayRect.left}px`;
    transitionImg.style.top = `${finalOverlayRect.top}px`;
    transitionImg.style.width = `${finalOverlayRect.width}px`;
    transitionImg.style.height = `${finalOverlayRect.height}px`;
    document.body.appendChild(transitionImg);
    activeTransitionImg = transitionImg;

    // Force reflow on the newly added clone so the browser registers its initial state!
    transitionImg.offsetHeight;

    // Hide original gallery image visually and hide the high-res image
    thumbImg.style.opacity = "0";
    if (fullScreenImage) {
      (fullScreenImage as HTMLElement).classList.remove("loaded");
    }

    // Shrink back to grid and fade out overlay
    setTimeout(() => {
      fullScreenEl.classList.remove("active");

      transitionImg.style.left = `${finalGalleryRect.left}px`;
      transitionImg.style.top = `${finalGalleryRect.top}px`;
      transitionImg.style.width = `${finalGalleryRect.width}px`;
      transitionImg.style.height = `${finalGalleryRect.height}px`;
    }, 20);

    // Cleanup after transition finishes
    setTimeout(() => {
      if (transitionImg.parentNode) {
        transitionImg.parentNode.removeChild(transitionImg);
      }
      if (activeTransitionImg === transitionImg) {
        activeTransitionImg = null;
      }
      thumbImg.style.opacity = "";

      if (fullScreenImage) {
        (fullScreenImage as HTMLElement).style.width = "";
        (fullScreenImage as HTMLElement).style.height = "";
      }

      fullScreenEl.style.display = "none";
      document.querySelector(".galleryImage.active")?.classList.remove("active");
      document.title = baseTitle;
      document.body.style.overflow = "";
      isExitAnimating = false;
    }, 400);

    if (pushState) {
      const path = window.location.pathname;
      const isPhotoDeepLink =
        path.startsWith("/photo/") &&
        path !== "/photo/map" &&
        !path.startsWith("/photo/albums/");
      if (isPhotoDeepLink) {
        const isMap = photoContent?.classList.contains("view-map");
        const basePath = isMap ? "/photo/map" : "/photo";
        if (window.location.pathname !== basePath) {
          window.history.pushState(
            { view: isMap ? "map" : "gallery" },
            "",
            basePath,
          );
        }
      }
    }
  }

  function setView(view: "gallery" | "map", pushState = true) {
    if (view === "gallery") {
      photoContent?.classList.remove("view-map");
      photoContent?.classList.add("view-gallery");
      document.getElementById("toggleGallery")?.classList.add("active");
      document.getElementById("toggleMap")?.classList.remove("active");
      window.dispatchEvent(
        new CustomEvent("photo-view-change", { detail: { view: "gallery" } }),
      );
      if (pushState && window.location.pathname !== "/photo") {
        window.history.pushState({ view: "gallery" }, "", "/photo");
        window.dispatchEvent(
          new CustomEvent("update-nav-active", { detail: { href: "/photo" } }),
        );
      }
    } else {
      photoContent?.classList.remove("view-gallery");
      photoContent?.classList.add("view-map");
      document.getElementById("toggleMap")?.classList.add("active");
      document.getElementById("toggleGallery")?.classList.remove("active");
      window.dispatchEvent(
        new CustomEvent("photo-view-change", { detail: { view: "map" } }),
      );
      if (pushState && window.location.pathname !== "/photo/map") {
        window.history.pushState({ view: "map" }, "", "/photo/map");
        window.dispatchEvent(
          new CustomEvent("update-nav-active", {
            detail: { href: "/photo/map" },
          }),
        );
      }
    }
  }

  galleryImages.forEach((image) => {
    image.addEventListener("click", () =>
      enterFullscreen(image as HTMLImageElement),
    );
  });

  exitButton?.addEventListener("click", () => exitFullscreen());

  nextButton?.addEventListener("click", () => {
    const currentImage = document.querySelector(
      ".galleryImage.active",
    ) as HTMLImageElement;
    if (currentImage?.nextElementSibling)
      enterFullscreen(currentImage.nextElementSibling as HTMLImageElement);
  });

  prevButton?.addEventListener("click", () => {
    const currentImage = document.querySelector(
      ".galleryImage.active",
    ) as HTMLImageElement;
    if (currentImage?.previousElementSibling)
      enterFullscreen(currentImage.previousElementSibling as HTMLImageElement);
  });

  window.addEventListener("keydown", (e) => {
    if (!fullScreenEl?.classList.contains("active")) return;
    if (e.key === "Escape") {
      e.preventDefault();
      exitFullscreen();
    }
    if (e.key === "ArrowRight") {
      e.preventDefault();
      nextButton?.click();
    }
    if (e.key === "ArrowLeft") {
      e.preventDefault();
      prevButton?.click();
    }
    if (e.key === "ArrowDown") {
      e.preventDefault();
      viewportBelow?.scrollIntoView({ behavior: "smooth", block: "end" });
    }
    if (e.key === "ArrowUp") {
      e.preventDefault();
      fullScreenScroll?.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  window.addEventListener("resize", updateFullscreenOrientation);

  document
    .getElementById("toggleGallery")
    ?.addEventListener("click", () => setView("gallery"));
  document
    .getElementById("toggleMap")
    ?.addEventListener("click", () => setView("map"));

  ["galleryNavLink", "mapNavLink"].forEach((id) => {
    document.getElementById(id)?.addEventListener("click", (e) => {
      e.preventDefault();
      const href = (e.currentTarget as HTMLElement).getAttribute("href");
      setView(href === "/photo/map" ? "map" : "gallery");
    });
  });

  window.addEventListener("popstate", (e) => {
    if (e.state?.photo) {
      const found = Array.from(galleryImages).find(
        (el) => el.getAttribute("data-name") === e.state.photo,
      );
      if (found) enterFullscreen(found as HTMLImageElement, false);
    } else {
      exitFullscreen(false);
    }
    if (e.state?.view) setView(e.state.view, false);
  });

  window.addEventListener("photo-map-click", (e: any) => {
    const found = Array.from(galleryImages).find(
      (el) => el.getAttribute("data-name") === e.detail.name,
    );
    if (found) enterFullscreen(found as HTMLImageElement);
  });

  if (window.location.pathname === "/photo/map") {
    window.dispatchEvent(
      new CustomEvent("update-nav-active", { detail: { href: "/photo/map" } }),
    );
  }

  const initialDeepLink = window.location.pathname;
  if (
    initialDeepLink.startsWith("/photo/") &&
    initialDeepLink !== "/photo/" &&
    initialDeepLink !== "/photo/map" &&
    !initialDeepLink.startsWith("/photo/albums/")
  ) {
    const slug = initialDeepLink.split("/").pop();
    const found = Array.from(galleryImages).find(
      (el) => cleanseName(el.getAttribute("data-name") || "") === slug,
    );
    if (found) enterFullscreen(found as HTMLImageElement, false);
  }

  const clipInput = document.querySelector("#clip") as HTMLInputElement;

  // --- AI State Configurations ---
  let modelSession: any = null;
  let tokenizer: any = null;
  let initializationPromise: Promise<any> | null = null;

  function initCLIP(): Promise<any> {
    if (modelSession && tokenizer) return Promise.resolve();
    if (initializationPromise) return initializationPromise;

    console.log("Injecting ONNX runtime and fetching CLIP components...");

    initializationPromise = new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src =
        "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.14.0/dist/ort.js";

      script.addEventListener("load", async () => {
        try {
          const modelPath =
            "https://huggingface.co/rocca/openai-clip-js/resolve/main/clip-text-vit-32-uint8.onnx";

          // @ts-ignore (ort is globally declared when script loads)
          const [session, TokenizerModule] = await Promise.all([
            // @ts-ignore
            ort.InferenceSession.create(modelPath, {
              executionProviders: ["wasm"],
            }),
            import("https://deno.land/x/clip_bpe@v0.0.6/mod.js"),
          ]);

          modelSession = session;
          tokenizer = new TokenizerModule.default();

          console.log("CLIP Model Loaded successfully.");
          if (clipInput) {
            clipInput.removeAttribute("disabled");
            clipInput.placeholder =
              'Any semantic query, ex. "New York City Sunset"';
          }
          resolve({ modelSession, tokenizer });
        } catch (err) {
          initializationPromise = null;
          if (clipInput) clipInput.placeholder = "Failed to load model layers.";
          reject(err);
        }
      });

      script.addEventListener("error", () => {
        initializationPromise = null;
        if (clipInput) clipInput.placeholder = "Failed to download runtime.";
        reject(new Error("ONNX Runtime script failed to load."));
      });

      document.head.appendChild(script);
    });

    return initializationPromise;
  }

  /**
   * Custom tokenization and inference logic using your loaded rocca engine
   */
  async function embedString(text: string): Promise<number[]> {
    // Blocks safely if the user tries entering a search before the promise resolves
    await initCLIP();

    // 1. Convert text string into token arrays via the Deno module
    const tokens = tokenizer.encode(text);

    // 2. Pad or truncate array length to exactly 77 elements (CLIP sequence standard)
    const sequenceLength = 77;
    const inputIds = new Int32Array(sequenceLength).fill(49407); // 49407 is CLIP EOT token
    inputIds[0] = 49406; // 49406 is CLIP SOT token

    for (let i = 0; i < Math.min(tokens.length, sequenceLength - 2); i++) {
      inputIds[i + 1] = tokens[i];
    }

    // 3. Construct ONNX input tensors
    // @ts-ignore
    const inputTensor = new ort.Tensor("int32", inputIds, [1, sequenceLength]);

    // 4. Run model inference
    const outputMap = await modelSession.run({ input: inputTensor });

    // The key output name inside rocca's custom ONNX configuration is typically 'output' or 'unnormalized_text_features'
    const outputTensor = outputMap[Object.keys(outputMap)[0]];
    const rawData = Array.from(outputTensor.data) as number[];

    // 5. Compute L2 Norm to output unit vector matching your Python image space
    let squareSum = 0;
    for (let i = 0; i < rawData.length; i++) {
      squareSum += rawData[i] * rawData[i];
    }
    const l2Norm = Math.sqrt(squareSum);
    return rawData.map((val) => val / (l2Norm || 1));
  }

  // --- Rest of your UI / Map / Gallery Logic code (From previous step) ---
  // ...

  // Kick off dynamic asset injections immediately on page mount
  initCLIP().catch((err) => console.error("Eager load tracking failed:", err));

  let debounceTimeout: number | undefined;

  clipInput.addEventListener("input", (e) => {
    clearTimeout(debounceTimeout);

    const query = (e.target as HTMLInputElement).value.trim();

    debounceTimeout = window.setTimeout(async () => {
      // If the query is empty, you could optionally sort by a default property (e.g., date)
      if (!query) return;

      try {
        console.log(`Embedding query: "${query}"`);
        const textVector = await embedString(query);

        // Locate the parent element holding your galleryImages list
        const galleryContainer =
          document.getElementById("gallery") ||
          document.getElementById("photoContent");
        if (!galleryContainer) return;

        // 1. Map, calculate similarities using your optimized custom de-quantizer function
        const scoredItems = Array.from(galleryImages).map((el) => {
          const htmlEl = el as HTMLElement;
          const encodedStr = htmlEl.getAttribute("data-emb") || "";

          let score = -1;
          if (encodedStr) {
            // Your utility directly takes the float vector and the base64 string
            score = dotProduct(textVector, encodedStr);
          }

          return { element: htmlEl, score };
        });

        // 2. Sort items descending by semantic proximity match
        scoredItems.sort((a, b) => b.score - a.score);

        // 3. Update DOM layout indexes using the low-overhead appendChild migration path
        scoredItems.forEach((item) => {
          galleryContainer.appendChild(item.element);
        });

        console.log(
          "Grid layout reordered using 4-bit vector math space mapping.",
        );
      } catch (err) {
        console.error("Semantic sort loop failure:", err);
      }
    }, 300);
  });
</script>
