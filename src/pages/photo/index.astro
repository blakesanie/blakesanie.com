---
import Gallery from "./_Gallery.astro";

const assetGlob = import.meta.glob(
  "/src/assets/portfolio_alias/*.{jpg,jpeg,png,webp}",
  {
    eager: true,
  },
) as Record<string, any>;
---

<!-- <p>test</p> -->
<Gallery
  initialMode={Astro.props.initialMode}
  assetGlob={assetGlob}
  allowClip={true}
  image={Astro.props.image}
  imageName={Astro.props.imageName}
  allowMap={true}
  allowFullscreen={true}
  randomize={true}
  allowFilename={false}
  allowBlog={true}
  allowUniqueUrls={true}
  heading="Photography"
  subheading="Photography offers me a creative escape from my logical, algorithmic side; allowing me to see the world with fresh eyes. From the vibrant streets of San Francisco to the timeless charm of Venice - even the familiar beauty of my own backyard - I find endless inspiration in the compositions that surround me."
/>
