---
import { getStaticPaths } from "./[slug].astro";
import Image from "../../../components/Image/index.astro";
//@ts-ignore
import HeaderAndFooter from "../../../components/HeaderAndFooter/index.astro";
import Substack from "../../../components/Substack.astro";

const staticPaths = await getStaticPaths();

function enforcePeriod(str: string) {
  if (str.endsWith(".")) return str;
  return str + ".";
}
---

<HeaderAndFooter
  allowMainStyles
  color="#eeeeeed0"
  colorOpaque="rgb(241, 241, 241)"
  themeColor="#f0f0f0"
  darkText
  hoverZoneBehind
  noBackdropFilter
  flangeColor="white"
  title="Albums"
  description="Image collections for preview and download"
>
  <h1>Albums</h1>
  <p>Images in bulk, refined by event or series. Download available for personal use - Enjoy!</p>
  <div id="albums">
    {
      staticPaths.map((item) => (
        <a href={"/photo/albums/" + item.params.slug}>
          <h2>{item.props.title}</h2>
          <p>{enforcePeriod(item.props.description || "")}</p>
          <Image
            src={item.props.assetGlob[item.props.imageFilePath]()}
            filepath={item.props.imageFilePath}
            alt={`${item.props.title} album cover`}
            widths={[800]}
            quality={75}
            format="avif"
            placeholder="color"
            loading="lazy"
          />
        </a>
      ))
    }
  </div>
  <Substack />
</HeaderAndFooter>

<style>
  #albums {
    display: flex;
    flex-wrap: wrap;
    font-size: 0.8em;
    margin-top: 1.5em;
    width: 100%;
    max-width: 1200px;
    justify-content: center;
    margin-bottom: 2em;
  }
  #albums > a {
    display: flex;
    flex-direction: column;
    flex: 1;
    /* border: 1px solid red; */
    padding: 1em;
    border-radius: 1em;
    min-width: min(100%, 350px);
    max-width: 500px;
    max-height: 400px;
    /* padding-left: 2em; */
  }
  #albums > a * {
    text-indent: 0 !important;
    text-align: left;
    padding: 0;
    width: calc(100% + 0.5em);
  }
  #albums img {
    display: block;
    width: 100%;
    flex-grow: 1; /* 3. Tells the image to expand and fill all remaining vertical space */
    min-height: 0; /* 4. Crucial Safari/Firefox fix: allows flex items to shrink/fit correctly */
    object-fit: cover; /* 5. Crops and fills the space beautifully without stretching or squishing */
  }
</style>
