---
import Gallery from "../_Gallery.astro";
import type { Props } from "../_Gallery.astro";

// Extract the type out of the function signature to fix the parsing bug
type StaticPathResult = {
  params: {
    slug: string;
  };
  props: Props & {
    imageFilePath: string;
  }
}[];

export async function getStaticPaths(): Promise<StaticPathResult> {
  const marathonImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/client_alias/chi-marathon-2025/*.{jpg,jpeg,png,webp,avif}",
  );

  const XXXRelayCrossImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/client_alias/relay-cross-2025/*.{jpg,jpeg,png,webp,avif}",
  );

  const mnrImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/client_alias/mnr-labor-day-2025/*.{jpg,jpeg,png,webp,avif}",
  );

  const aw2026Images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/client_alias/chi-aw-show-2026/*.{jpg,jpeg,png,webp,avif}",
  );

  return [
    {
      params: { slug: "chi-air-and-water-show-2026" },
      props: {
        assetGlob: aw2026Images,
        title: "Chicago Air and Water Show 2026",
        description: "Chicago's annual lakefront aviation exposition.",
        heading: "Chicago Air and Water Show 2026",
        allowDownload: false,
        allowFilename: false,
        allowFullscreen: true,
        allowMetadata: true,
        imageFilePath:
          "/src/assets/client_alias/chi-aw-show-2026/DSC06713.jpg",
        subheading:
          'August 2026 - Chicago Lakefront. <a href="mailto:blake@sanie.com">Email</a> for Licensing.</a>',
      },
    },
    {
      params: { slug: "chi-marathon-2025" },
      props: {
        assetGlob: marathonImages,
        title: "Chicago Marathon 2025",
        description: "October 12, 2025. Chicago Marathon in Old Town.",
        heading: "Chicago Marathon 2025",
        allowDownload: false,
        allowFilename: true,
        imageFilePath:
          "/src/assets/client_alias/chi-marathon-2025/DSC02413.jpg",
        subheading:
          'October 12, 2025. Chicago Marathon along LaSalle (mile 4) and Wells (mile 12). Download available for personal use. <a href="https://www.instagram.com/blakesanie.jpg/" target="_blank">@blakesanie.jpg</a>',
      },
    },
    {
      params: { slug: "xxx-relay-cross-2025" },
      props: {
        assetGlob: XXXRelayCrossImages,
        title: "XXX Relay Cross 2025",
        description: "September 14, 2025. Cyclocross Relay Bike Race Images",
        heading: "XXX Relay Cross 2025",
        allowDownload: false,
        allowFilename: true,
        imageFilePath: "/src/assets/client_alias/relay-cross-2025/DSC01406.jpg",
        subheading:
          'September 14, 2025, at Jackson Park, Chicago. Download available for personal use. Attribution <a href="https://www.instagram.com/blakesanie.jpg/" target="_blank">@blakesanie.jpg</a>',
      },
    },
    {
      params: { slug: "mnr-labor-day-2025" },
      props: {
        assetGlob: mnrImages,
        title: "MNR Labor Day 2025",
        description: "September 1, 2025. Photographs from Monday Night Ride.",
        heading: "MNR Labor Day 2025",
        allowDownload: true,
        allowFilename: true,
        imageFilePath:
          "/src/assets/client_alias/mnr-labor-day-2025/DSC00237.jpg",
      },
    },
  ];
}
---

<Gallery {...Astro.props} />
