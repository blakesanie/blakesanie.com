---
import Gallery from "../_Gallery.astro";
import type { Props } from "../_Gallery.astro";
import { albums } from "../../../data/albums";
import type { Album } from "../../../types/content";

// Extract the type out of the function signature to fix the parsing bug
type StaticPathResult = {
  params: {
    slug: string;
  };
  props: Props & {
    imageFilePath: string;
  }
}[];

type AlbumDefinition = Album & {
  assetGlob: Record<string, () => Promise<{ default: ImageMetadata }>>;
};

export async function getStaticPaths(): Promise<StaticPathResult> {
  const marathonImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/client_alias/chi-marathon-2025/*.{jpg,jpeg,png,webp,avif}",
  );

  const XXXRelayCrossImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/client_alias/relay-cross-2025/*.{jpg,jpeg,png,webp,avif}",
  );

  const mnrImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/client_alias/mnr-labor-day-2025/*.{jpg,jpeg,png,webp,avif}",
  );

  const aw2026Images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/client_alias/chi-aw-show-2026/*.{jpg,jpeg,png,webp,avif}",
  );

  const northMich2026Images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/client_alias/north-mich/*.{jpg,jpeg,png,webp,avif}",
  );

  const assetGlobs: Record<string, AlbumDefinition["assetGlob"]> = {
    "northern-michigan-2026": northMich2026Images,
    "chi-air-and-water-show-2026": aw2026Images,
    "chi-marathon-2025": marathonImages,
    "xxx-relay-cross-2025": XXXRelayCrossImages,
    "mnr-labor-day-2025": mnrImages,
  };

  return albums.map((album) => ({
    params: { slug: album.slug },
    props: {
      ...album,
      assetGlob: assetGlobs[album.slug],
    },
  }));
}
---

<Gallery {...Astro.props} />
