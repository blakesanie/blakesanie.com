---
import HeaderAndFooter from "../../components/HeaderAndFooter/index.astro";
import { Icon } from "astro-icon/components";
//@ts-ignore
import Button from "../../components/basic/Button.astro";
import Substack from "../../components/Substack.astro";
import Image from "../../components/Image/index.astro";
import type { ImageMetadata } from "astro";
import { projects } from "../../data/projects";

// Dynamically grab all local images from your assets directory at build time
const imagesGlob = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{png,jpg,jpeg}",
);


function toFragrment(str: string) {
  return str.split("(")[0].toLowerCase().replaceAll(" ", "-");
}
---

<HeaderAndFooter
  allowMainStyles
  title="Projects"
  description="My collective showcase of personal and academic projects, focused on Full-Stack, Data, and Machine Learning applications."
>
  <h1>Projects</h1>
  <p>
    My software engineering journey is rooted in hands-on projects and driven by
    a passion for continuous growth. Dive into my portfolio of applications,
    services, and research spanning Full-Stack Development, Data Engineering,
    and Machine Learning. From writing my first 'Hello World!' at 14 to earning
    a Master's in Computer Science, these projects reflect milestones in my
    skills, curiosity, and ever-expanding impact.
  </p>
  <div id="projects">
    {
      projects.map(({ title, id, description, tech, ...project }) => {
        const defaultLink =
          project.links && project.links[0] && project.links[0].href;

        // Resolve target image module dynamically from global build manifest
        const imageSrc =
          project.image && imagesGlob[project.image]
            ? imagesGlob[project.image]()
            : null;

        return (
          <div class="project" id={id || toFragrment(title)}>
            <div class="info">
              <h2 class="title">
                {title}
                <Icon name="ic:round-content-copy" class="copy" />
                <Icon name="ic:round-check" class="check" />
              </h2>
              <p class="desc">{description}</p>
              {tech && (
                <div class="tech">
                  {tech.map(({ icon, name }) => {
                    return <Icon name={icon} data-tech={name} size="1.8em" />;
                  })}
                  <div class="selectedTech" />
                </div>
              )}

              {project.links && (
                <div class="links">
                  {project.links.map(({ label, href, ...link }) => {
                    return (
                      <a href={href} target="_blank" class="link">
                        <Button icon={link.icon}>{label}</Button>
                      </a>
                    );
                  })}
                </div>
              )}
            </div>
            <a class="demo" href={defaultLink} target="_blank">
              {imageSrc ? (
                <Image
                  placeholder="blur"
                  src={imageSrc}
                  filepath={project.image}
                  alt={`Screenshot visualization of ${title}`}
                  loading="lazy"
                  width={800}
                  quality={75}
                  format="avif"
                />
              ) : project.youtube ? (
                <iframe
                  src={project.youtube}
                  allow="autoplay; encrypted-media"
                  allowfullscreen="allowfullscreen"
                  class="youtube"
                />
              ) : null}
            </a>
          </div>
        );
      })
    }
  </div>
  <Substack />
</HeaderAndFooter>

<style>
  .project {
    padding: 1em 1.25em;
    box-shadow: 0 0 2em 0 rgba(0, 0, 0, 0.06);
    border-radius: 1em;
    margin: 2em 0;
    display: flex;
    position: relative;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }
  .project:nth-of-type(2n) {
    flex-direction: row-reverse;
  }
  .info {
    display: flex;
    flex: 1;
    min-width: min(100%, 400px);
  }
  .demo {
    flex: 1;
    min-width: min(100%, 300px);
    max-width: min(100%, 450px);
  }
  .demo :global(img) {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .demo iframe.youtube {
    aspect-ratio: calc(16 / 9);
    width: 100%;
    border: none;
  }
  .project > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 0.75em;
    padding: 1em 0;
  }
  .title {
    display: flex;
    align-items: center;
  }
  .desc {
    font-size: 1em;
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .title [data-icon] {
    height: 0.9em;
    min-width: 0.9em;
    color: #00000040;
    margin-left: 0.2em;
    cursor: pointer;
  }

  .title [data-icon]:hover {
    color: var(--headerColor);
  }

  .title .check {
    display: none;
  }

  .tech [data-icon] {
    border-radius: 0.2em;
    margin: 0.4em;
    transition: all 0.1s ease;
    cursor: pointer;
  }

  .tech [data-icon]:hover {
    transform: scale(1.2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1em;
  }

  .selectedTech {
    width: 100%;
    font-size: 1em;
    line-height: 1em;
    height: 1em;
    margin-top: 0.3em;
    text-align: center;
    z-index: 10;
  }

  .link {
    margin: 0.5em;
  }
</style>

<script>
  const techIcons = document.querySelectorAll(".tech svg");

  for (let i = 0; i < techIcons.length; i++) {
    function showTech(e: Event) {
      const target = e.target;
      if (target instanceof Element) {
        const attr = target.getAttribute("data-tech");
        const selected = target.parentNode?.querySelector(".selectedTech");
        if (attr && selected) {
          selected.innerHTML = attr;
        }
      }
    }
    techIcons[i].addEventListener("mouseenter", showTech);
    techIcons[i].addEventListener("click", showTech);
  }

  const containers = document.querySelectorAll(".tech");
  for (let i = 0; i < containers.length; i++) {
    const container = containers[i];
    container.addEventListener("mouseleave", (e) => {
      const target = e.target as HTMLElement;
      if (target) {
        const selected = target.querySelector(".selectedTech");
        if (selected) {
          selected.innerHTML = "";
        }
      }
    });
  }

  const copyIcons: Record<string, HTMLElement> = {};
  const checkIcons: Record<string, HTMLElement> = {};

  const titleIcons = document.querySelectorAll("h2 svg");
  for (let i = 0; i < titleIcons.length; i++) {
    const titleIcon = titleIcons[i] as HTMLElement;
    const id = titleIcon.parentElement?.parentElement?.parentElement?.id;
    if (!id) continue;

    if (titleIcon.classList.contains("check")) {
      checkIcons[id] = titleIcon;
    } else {
      copyIcons[id] = titleIcon;
    }
    titleIcon.addEventListener("click", () => {
      const url = window.location.href.split("#")[0] + "#" + id;
      navigator.clipboard.writeText(url);
      history.pushState(null, "", url);
      for (const id2 in copyIcons) {
        if (id == id2) {
          checkIcons[id].style.display = "block";
          copyIcons[id].style.display = "none";
        } else {
          copyIcons[id2].style.display = "block";
          checkIcons[id2].style.display = "none";
        }
      }
    });
  }
</script>
