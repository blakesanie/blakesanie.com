{
  "name": "blakesanie.com",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "astro dev --host --port $PORT",
    "dev3000": "astro dev --host --port 3000",
    "start": "astro dev",
    "build": "astro build && node minify.mjs",
    "preview": "pnpm exec wrangler pages dev",
    "astro": "astro",
    "deploy": "pnpm build && pnpm exec wrangler pages deploy dist --branch=main",
    "clean": "rm -rf .astro dist node_modules/.vite",
    "test": "vitest run --config vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "lint": "eslint astro.config.ts src/lib src/types src/data"
  },
  "dependencies": {
    "@iconify-json/devicon": "^1.2.24",
    "@iconify-json/ic": "^1.2.2",
    "@iconify-json/ion": "^1.2.3",
    "@iconify-json/jam": "^1.2.3",
    "@iconify-json/la": "^1.2.1",
    "@iconify-json/logos": "^1.2.4",
    "@iconify-json/lucide": "^1.2.44",
    "@iconify-json/majesticons": "^1.2.2",
    "@iconify-json/material-icon-theme": "^1.2.10",
    "@iconify-json/material-symbols": "^1.2.33",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/mi": "^1.2.2",
    "@iconify-json/ri": "^1.2.5",
    "@iconify-json/simple-icons": "^1.2.35",
    "@iconify-json/tabler": "^1.2.18",
    "@iconify-json/twemoji": "^1.2.2",
    "@iconify-json/uil": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.21",
    "astro": "^7.0.7",
    "astro-google-fonts-optimizer": "^0.2.2",
    "astro-icon": "^1.1.5",
    "astro-sitemap": "^1.0.0",
    "glob-promise": "^6.0.7",
    "satori": "^0.13.1",
    "sharp": "^0.35.1",
    "vite-image-pipeline": "file:plugins/vite-image-pipeline",
    "wrangler": "^4.104.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/humbleicons": "^1.2.10",
    "@types/node": "^22.15.21",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.9"
  }
}
